---
const stats = [
  { value: '50', suffix: '+', label: 'Brands Scaled Globally' },
  { value: '10', prefix: '$', suffix: 'M+', label: 'Ad Spend Managed' },
  { value: '300', suffix: '%', label: 'Average Client ROAS' },
  { value: '15', suffix: '+', label: 'Countries Served' },
];
---

<section class="stats-section">
  <div class="stats-bg" aria-hidden="true">
    <div class="stats-glow stats-glow--left"></div>
    <div class="stats-glow stats-glow--right"></div>
  </div>
  <div class="container stats-inner">
    <p class="stats-label reveal">By the Numbers</p>
    <div class="stats-grid stagger-children">
      {stats.map(s => (
        <div class="stat-item">
          <div class="stat-value">
            {s.prefix && <span class="stat-prefix">{s.prefix}</span>}
            <span class="count-up" data-target={s.value} data-suffix={s.suffix ?? ''} data-prefix={s.prefix ?? ''}>
              {s.prefix ?? ''}{s.value}{s.suffix ?? ''}
            </span>
          </div>
          <p class="stat-label">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-section {
    position: relative;
    padding: 6rem 0;
    overflow: hidden;
  }

  .stats-bg {
    position: absolute;
    inset: 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .stats-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .stats-glow--left {
    background: radial-gradient(circle, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
    top: -100px;
    left: -100px;
  }

  .stats-glow--right {
    background: radial-gradient(circle, rgba(123, 63, 160, 0.12) 0%, transparent 70%);
    bottom: -100px;
    right: -100px;
  }

  .stats-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .stats-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 3rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
  }

  .stat-item {
    background: var(--bg-surface);
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transition: background 0.3s;
  }

  .stat-item:hover { background: var(--bg-elevated); }

  .stat-value {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--gold-primary);
    line-height: 1;
  }

  .stat-prefix {
    font-size: 60%;
    opacity: 0.8;
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: 1fr; }
  }
</style>
