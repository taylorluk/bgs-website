</style>

<script>
  // ── Terminal progress bar counter ──────────────────────────
  const pct = document.getElementById('tp-pct');
  if (pct) {
    let val = 0;
    setInterval(() => {
      val = (val + 0.4) % 97;
      pct.textContent = Math.round(val) + '%';
    }, 16);
  }

  // ── AI Capabilities interactive showcase ───────────────────
  const CYCLE_MS = 4000;

  const items  = Array.from(document.querySelectorAll('.cap-item'))  as HTMLElement[];
  const slides = Array.from(document.querySelectorAll('.cap-slide')) as HTMLElement[];
  const dots   = Array.from(document.querySelectorAll('.cap-dot'))   as HTMLElement[];

  if (items.length && slides.length) {
    let current   = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function switchTo(idx: number) {
      // Remove active from all
      items[current].classList.remove('cap-item--active');
      slides[current].classList.remove('cap-slide--active');
      dots[current]?.classList.remove('cap-dot--active');

      current = idx;

      items[current].classList.add('cap-item--active');
      slides[current].classList.add('cap-slide--active');
      dots[current]?.classList.add('cap-dot--active');

      // Restart progress bar animation
      const fill = items[current].querySelector('.cap-progress-fill') as HTMLElement | null;
      if (fill) {
        fill.style.animation = 'none';
        // Force reflow
        void fill.offsetWidth;
        fill.style.animation = '';
      }
    }

    function startCycle() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => {
        switchTo((current + 1) % items.length);
      }, CYCLE_MS);
    }

    // Click on list items
    items.forEach((item, i) => {
      item.addEventListener('click', () => {
        switchTo(i);
        startCycle(); // reset timer on manual click
      });
    });

    // Click on dot nav
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        switchTo(i);
        startCycle();
      });
    });

    // Kick off auto-cycle
    startCycle();
  }
</script>
