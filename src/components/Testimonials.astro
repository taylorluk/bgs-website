  },
];

const col3 = [
  {
    quote: "From branding to paid ads to automation — they handled everything seamlessly. Our Dubai launch exceeded every expectation. World-class team, incredibly responsive.",
    name: "Omar Khalid",
    title: "Head of Marketing",
    company: "Crest Developments",
    region: "Riyadh, KSA",
    stars: 5,
    platform: "Google",
  },
  {
    quote: "BGS built our brand identity from scratch — logo, fonts, tone of voice, the whole system. Then they launched our Meta campaigns and we hit profitability in week one. Extraordinary.",
    name: "Fatima Al-Zaabi",
    title: "Co-Founder",
    company: "Safa Wellness Studio",
    region: "Dubai, UAE",
    stars: 5,
    platform: "Google",
  },
  {
