---
// 12 testimonials split across 3 columns (4 each) — each column is doubled for seamless loop
const col1 = [
  {
    quote: "BGS transformed our entire digital presence. Within 90 days our ROAS was 4× what we achieved with our previous agency. The AI-driven creative testing alone was a game changer.",
    name: "Sarah Al-Mansouri",
    title: "CMO",
    company: "Luxe Retail Group",
    region: "Dubai, UAE",
    stars: 5,
    platform: "Google",
