---
import faqs from '../data/faqs.js';
---

<section class="section faq-section" id="faq">
  <!-- Background accent -->
  <div class="faq-bg-glow" aria-hidden="true"></div>

  <div class="container faq-inner">
    <!-- Left: Header -->
    <div class="faq-header reveal-left">
      <p class="section-label">Got Questions?</p>
      <h2 class="faq-title">
        Everything You<br />
        Need to <span class="text-gold-gradient">Know</span>
      </h2>
      <p class="faq-sub">
        We believe in complete transparency. If something isn't answered here,
        we're one call away.
      </p>
      <a href="/contact" class="btn-gold faq-cta">
        Book a Free Call
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>

      <!-- Trust note -->
      <div class="faq-trust">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-primary)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>No pitch. No pressure. Just a genuine conversation about your goals.</span>
      </div>
    </div>

    <!-- Right: Accordion -->
    <div class="faq-accordion reveal-right">
      {faqs.map((item, i) => (
        <div class="faq-item" data-faq-item>
          <button
            class="faq-question"
            aria-expanded="false"
            data-faq-trigger
          >
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg class="icon-plus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <svg class="icon-minus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </button>
          <div class="faq-answer" data-faq-answer>
            <p>{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    position: relative;
    overflow: hidden;
  }

  .faq-bg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Layout ──────────────────────────────────────────────── */
  .faq-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 5rem;
    align-items: start;
  }

  /* ── Left header ─────────────────────────────────────────── */
  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 1rem;
    display: block;
  }

  .faq-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .faq-sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.75;
    margin-bottom: 2rem;
    max-width: 36ch;
  }

  .faq-cta {
    display: inline-flex;
    margin-bottom: 1.75rem;
  }

  .faq-trust {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.55;
  }

  .faq-trust svg { flex-shrink: 0; margin-top: 1px; }

  /* ── Accordion ───────────────────────────────────────────── */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--border-subtle);
  }

  .faq-item:first-child {
    border-top: 1px solid var(--border-subtle);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    transition: color 0.2s;
  }

  .faq-question:hover { color: var(--gold-primary); }

  .faq-question[aria-expanded="true"] { color: var(--gold-primary); }

  .faq-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: rgba(201, 168, 76, 0.06);
    border: 1px solid var(--border-subtle);
    color: var(--gold-primary);
    transition: background 0.2s, transform 0.3s;
    margin-top: 0.1rem;
  }

  .faq-question[aria-expanded="true"] .faq-icon {
    background: rgba(201, 168, 76, 0.12);
    transform: rotate(180deg);
  }

  .icon-plus  { display: block; }
  .icon-minus { display: none; }

  .faq-question[aria-expanded="true"] .icon-plus  { display: none; }
  .faq-question[aria-expanded="true"] .icon-minus { display: block; }

  .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }

  .faq-answer p {
    padding: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .faq-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .faq-sub { max-width: none; }
  }
</style>

<script>
  document.querySelectorAll('[data-faq-item]').forEach(item => {
    const trigger = item.querySelector('[data-faq-trigger]') as HTMLButtonElement;
    const answer  = item.querySelector('[data-faq-answer]') as HTMLElement;

    if (!trigger || !answer) return;

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('[data-faq-trigger]').forEach(t => {
        const a = t.closest('[data-faq-item]')?.querySelector('[data-faq-answer]') as HTMLElement;
        t.setAttribute('aria-expanded', 'false');
        if (a) a.style.maxHeight = '0';
      });

      // Toggle this one
      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }
    });
  });
</script>
