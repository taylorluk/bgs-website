---
import { imageDims } from '../lib/images.js';
const services = [
  {
    tag: 'Paid Media',
    title: 'Paid Performance',
    headline: 'Every Dollar Works Harder',
    desc: 'Meta, Google, TikTok & Snapchat — multi-platform campaigns engineered for exceptional ROAS. From audience architecture and creative testing to real-time bid optimisation.',
    stat: '4.2× Avg ROAS',
    href: '/services/paid-advertising',
    image: 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=900&h=800&q=80&auto=format&fit=crop',
    accent: 'gold',
    span: 'large',
  },
  {
    tag: 'Social',
    title: 'Social Media & Content',
    headline: 'Content That Stops the Scroll',
    desc: 'Platform-native content strategy, production, and community management built for real audience growth and conversion.',
    stat: '10M+ Monthly Reach',
    href: '/services/social-media-management',
    image: 'https://images.unsplash.com/photo-1562577309-4932fdd64cd1?w=700&h=500&q=80&auto=format&fit=crop',
    accent: 'purple',
    span: 'medium',
  },
  {
    tag: 'AI',
    title: 'AI Marketing',
    headline: 'The Future of Marketing',
    desc: 'Predictive targeting, AI-generated creatives at scale, intelligent optimisation, and automated reporting — not a buzzword, our core infrastructure.',
    stat: '5× Faster Output',
    href: '/services/ai-content-at-scale',
    image: 'https://images.unsplash.com/photo-1677442135703-1787eea5ce01?w=700&h=500&q=80&auto=format&fit=crop',
    accent: 'pink',
    span: 'medium',
  },
  {
    tag: 'Brand',
    title: 'Branding & Creative',
    headline: 'Build a Brand Worth Remembering',
    desc: 'Strategy-led identities, visual systems, and creative direction that carve out lasting market position and command premium pricing.',
    stat: '200+ Brands Built',
    href: '/services/branding-creative',
    image: 'https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=1000&h=450&q=80&auto=format&fit=crop',
    accent: 'amber',
    span: 'wide',
  },
  {
    tag: 'Web',
    title: 'Web & Funnels',
    headline: 'Sites That Sell While You Sleep',
    desc: 'High-converting websites, landing pages, and funnel systems engineered for maximum lead capture and revenue.',
    stat: '35% Conv. Lift Avg.',
    href: '/services/web-design-development',
    image: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=700&h=500&q=80&auto=format&fit=crop',
    accent: 'blue',
    span: 'medium',
  },
  {
    tag: 'Automation',
    title: 'Tech & Automation',
    headline: 'Growth on Autopilot',
    desc: 'CRM setup, workflow automation, API integrations, and intelligent systems that scale without adding headcount.',
    stat: '60% Time Saved',
    href: '/services/marketing-automation',
    image: 'https://images.unsplash.com/photo-1518770660439-4636190af475?w=700&h=500&q=80&auto=format&fit=crop',
    accent: 'gold',
    span: 'medium',
  },
  {
    tag: 'SEO',
    title: 'SEO & Content Strategy',
    headline: 'Own Your Category on Google',
    desc: 'Technical SEO, pillar content, and authority building that compounds month over month for long-term organic dominance.',
    stat: 'Top 3 Rankings',
    href: '/services/seo-local-search',
    image: 'https://images.unsplash.com/photo-1432888498266-38ffec3eaf0a?w=1000&h=450&q=80&auto=format&fit=crop',
    accent: 'purple',
    span: 'wide',
  },
  {
    tag: 'Influence',
    title: 'Influencer & PR',
    headline: 'Trusted Voices. Authentic Reach.',
    desc: 'Curated creator campaigns, media partnerships, and strategic PR that build credibility and awareness at scale.',
    stat: '500+ Creator Network',
    href: '/services/influencer-pr',
    image: 'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=1000&h=450&q=80&auto=format&fit=crop',
    accent: 'pink',
    span: 'wide',
  },
  {
    tag: 'Email',
    title: 'Email Marketing',
    headline: 'The Highest ROI Channel. Mastered.',
    desc: 'Lifecycle campaigns, automated sequences, and retention flows that turn leads into loyal customers.',
    stat: '$42 for Every $1',
    href: '/services/email-sms-marketing',
    image: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=700&h=500&q=80&auto=format&fit=crop',
    accent: 'blue',
    span: 'medium',
  },
  {
    tag: 'Video',
    title: 'Video Production',
    headline: 'Stories That Move People',
    desc: 'Brand films, ad creatives, reels, and documentary-style content crafted to stop the scroll and drive action.',
    stat: '3× Engagement Rate',
    href: '/services/content-marketing',
    image: 'https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=700&h=500&q=80&auto=format&fit=crop',
    accent: 'amber',
    span: 'medium',
  },
];
---

<section class="section services-section" id="services">
  <!-- Ambient glow -->
  <div class="svc-glow" aria-hidden="true"></div>

  <div class="container">
    <!-- Header -->
    <div class="svc-header reveal">
      <p class="section-label">What We Do</p>
      <h2 class="svc-title">
        One Agency.<br />
        <span class="text-gold-gradient">Every Edge You Need.</span>
      </h2>
      <p class="svc-sub">
        Most agencies do one thing. We do everything — and we do it better.
        Ten disciplines. One team. No coordination gaps.
      </p>
    </div>

    <!-- Bento grid -->
    <div class="bento-grid stagger-children">
      {services.map((svc, i) => (
        <a
          href={svc.href}
          class={`bento-card bento-card--${svc.span} bento-card--${svc.accent}`}
          data-index={i}
        >
          <!-- Background image -->
          <div class="bento-img-wrap">
            <img
              src={svc.image}
              width={imageDims(svc.image).width}
              height={imageDims(svc.image).height}
              alt={svc.title}
              class="bento-img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Gradient overlay -->
          <div class="bento-overlay"></div>

          <!-- Noise texture -->
          <div class="bento-noise" aria-hidden="true"></div>

          <!-- Top row: tag + stat -->
          <div class="bento-top">
            <span class={`bento-tag bento-tag--${svc.accent}`}>
              <span class="tag-dot"></span>
              {svc.tag}
            </span>
            <span class="bento-stat">{svc.stat}</span>
          </div>

          <!-- Bottom content -->
          <div class="bento-bottom">
            <!-- Always visible -->
            <h3 class="bento-title">{svc.title}</h3>
            <!-- Hover reveal -->
            <div class="bento-reveal">
              <p class="bento-headline">{svc.headline}</p>
              <p class="bento-desc">{svc.desc}</p>
              <span class={`bento-cta bento-cta--${svc.accent}`}>
                Explore Service
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>

          <!-- Hover glow border (CSS only) -->
          <div class="bento-border-glow" aria-hidden="true"></div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    overflow: hidden;
  }

  .svc-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle,
      rgba(201, 168, 76, 0.04) 0%,
      rgba(123, 63, 160, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* ── Header ──────────────────────────────────────────────── */
  .svc-header {
    margin-bottom: 3rem;
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 1rem;
    display: block;
  }

  .svc-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .svc-sub {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 52ch;
  }

  /* ── Bento grid ──────────────────────────────────────────── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: 380px 260px 260px 250px;
    gap: 0.875rem;
  }

  /* Span rules — maps to card order */
  .bento-card:nth-child(1)  { grid-column: 1 / 3; grid-row: 1 / 3; } /* large: Paid Ads */
  .bento-card:nth-child(2)  { grid-column: 3;     grid-row: 1; }      /* Social */
  .bento-card:nth-child(3)  { grid-column: 4;     grid-row: 1; }      /* AI */
  .bento-card:nth-child(4)  { grid-column: 3 / 5; grid-row: 2; }     /* wide: Branding */
  .bento-card:nth-child(5)  { grid-column: 1;     grid-row: 3; }      /* Web */
  .bento-card:nth-child(6)  { grid-column: 2;     grid-row: 3; }      /* Tech */
  .bento-card:nth-child(7)  { grid-column: 3 / 5; grid-row: 3; }     /* wide: SEO */
  .bento-card:nth-child(8)  { grid-column: 1 / 3; grid-row: 4; }     /* wide: Influencer */
  .bento-card:nth-child(9)  { grid-column: 3;     grid-row: 4; }      /* Email */
  .bento-card:nth-child(10) { grid-column: 4;     grid-row: 4; }      /* Video */

  /* ── Card base ───────────────────────────────────────────── */
  .bento-card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.06);
    transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.35s ease;
  }

  .bento-card:hover { transform: translateY(-3px) scale(1.005); }

  /* Accent border glow on hover */
  .bento-card--gold:hover  { border-color: rgba(201,168,76,0.4);  box-shadow: 0 20px 60px rgba(201,168,76,0.12),  inset 0 0 0 1px rgba(201,168,76,0.15); }
  .bento-card--purple:hover{ border-color: rgba(123,63,160,0.4);  box-shadow: 0 20px 60px rgba(123,63,160,0.12), inset 0 0 0 1px rgba(123,63,160,0.15); }
  .bento-card--pink:hover  { border-color: rgba(196,64,128,0.4);  box-shadow: 0 20px 60px rgba(196,64,128,0.12), inset 0 0 0 1px rgba(196,64,128,0.15); }
  .bento-card--amber:hover { border-color: rgba(212,112,74,0.4);  box-shadow: 0 20px 60px rgba(212,112,74,0.12), inset 0 0 0 1px rgba(212,112,74,0.15); }
  .bento-card--blue:hover  { border-color: rgba(30,77,183,0.4);   box-shadow: 0 20px 60px rgba(30,77,183,0.12),  inset 0 0 0 1px rgba(30,77,183,0.15); }

  /* ── Image ───────────────────────────────────────────────── */
  .bento-img-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.5s ease;
    filter: brightness(0.65) saturate(0.8);
  }

  .bento-card:hover .bento-img {
    transform: scale(1.08);
    filter: brightness(0.45) saturate(0.7);
  }

  /* ── Gradient overlay ────────────────────────────────────── */
  .bento-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(7,12,30,0.1) 0%,
      rgba(7,12,30,0.2) 35%,
      rgba(7,12,30,0.75) 65%,
      rgba(7,12,30,0.96) 100%
    );
    transition: background 0.4s ease;
  }

  .bento-card:hover .bento-overlay {
    background: linear-gradient(
      to bottom,
      rgba(7,12,30,0.3) 0%,
      rgba(7,12,30,0.5) 35%,
      rgba(7,12,30,0.88) 60%,
      rgba(7,12,30,0.98) 100%
    );
  }

  /* ── Noise texture ───────────────────────────────────────── */
  .bento-noise {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px;
    pointer-events: none;
  }

  /* ── Top row ─────────────────────────────────────────────── */
  .bento-top {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    right: 1.1rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .bento-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
    backdrop-filter: blur(12px);
    white-space: nowrap;
    border: 1px solid;
    transition: opacity 0.3s;
  }

  .bento-tag--gold   { color: var(--gold-light);   background: rgba(201,168,76,0.12);  border-color: rgba(201,168,76,0.3); }
  .bento-tag--purple { color: var(--purple-light);  background: rgba(123,63,160,0.12); border-color: rgba(123,63,160,0.3); }
  .bento-tag--pink   { color: #f9a8d4;              background: rgba(196,64,128,0.12); border-color: rgba(196,64,128,0.3); }
  .bento-tag--amber  { color: #fdba74;              background: rgba(212,112,74,0.12); border-color: rgba(212,112,74,0.3); }
  .bento-tag--blue   { color: #93c5fd;              background: rgba(30,77,183,0.12);  border-color: rgba(30,77,183,0.3); }

  .tag-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.6); }
  }

  .bento-stat {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    background: rgba(7,12,30,0.5);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 0.22rem 0.6rem;
    border-radius: 6px;
    backdrop-filter: blur(8px);
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.3s;
  }

  .bento-card:hover .bento-stat { opacity: 0; }

  /* ── Bottom content ──────────────────────────────────────── */
  .bento-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 3;
    padding: 1.4rem;
    overflow: hidden;
  }

  .bento-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
    transform: translateY(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Large card title bigger */
  .bento-card:nth-child(1) .bento-title {
    font-size: 1.5rem;
  }

  .bento-card:hover .bento-title {
    transform: translateY(-4px);
  }

  /* Hover reveal block */
  .bento-reveal {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(12px);
    transition:
      max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease 0.05s,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover .bento-reveal {
    max-height: 200px;
    opacity: 1;
    transform: translateY(0);
  }

  .bento-headline {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--gold-primary);
    margin: 0.4rem 0 0.5rem;
    letter-spacing: 0.01em;
  }

  .bento-desc {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
    margin-bottom: 0.85rem;
  }

  /* Wide/large cards show more desc */
  .bento-card:nth-child(1) .bento-desc,
  .bento-card:nth-child(4) .bento-desc,
  .bento-card:nth-child(7) .bento-desc,
  .bento-card:nth-child(8) .bento-desc {
    font-size: 0.85rem;
  }

  /* CTA */
  .bento-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: gap 0.2s;
  }

  .bento-cta:hover { gap: 0.65rem; }

  .bento-cta--gold   { color: var(--gold-primary); }
  .bento-cta--purple { color: var(--purple-light); }
  .bento-cta--pink   { color: #f9a8d4; }
  .bento-cta--amber  { color: #fdba74; }
  .bento-cta--blue   { color: #93c5fd; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
    }

    /* Reset all explicit placements */
    .bento-card:nth-child(n) {
      grid-column: auto;
      grid-row: auto;
    }

    /* Re-apply just the wide/large ones */
    .bento-card:nth-child(1) { grid-column: 1 / -1; min-height: 360px; }
    .bento-card:nth-child(4) { grid-column: 1 / -1; }
    .bento-card:nth-child(7) { grid-column: 1 / -1; }
    .bento-card:nth-child(8) { grid-column: 1 / -1; }

    .bento-card { min-height: 280px; }
  }

  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }

    .bento-card:nth-child(n) {
      grid-column: 1;
      min-height: 260px;
    }

    .bento-card:nth-child(1) { min-height: 320px; }
  }
</style>
