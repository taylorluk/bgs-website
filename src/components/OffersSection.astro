    font-weight: 600;
  }

  .timer-val {
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: #fb923c;
  }

  /* ── Highlight ────────────────────────────────────────────── */
  .ocard-highlight {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
