  /* ── Timer ────────────────────────────────────────────────── */
  .ocard-timer {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: #fb923c;
    background: rgba(251,146,60,0.08);
    border: 1px solid rgba(251,146,60,0.2);
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    margin-bottom: 0.7rem;
