  .offers-track::-webkit-scrollbar { display: none; }
  .offers-track.is-dragging { cursor: grabbing; }

  /* Fade edges */
  .track-fade {
    position: absolute;
    top: 0; bottom: 0;
    width: 80px;
    pointer-events: none;
    z-index: 2;
  }
  .track-fade--left  {
