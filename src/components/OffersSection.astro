// Build data-attrs for JS timers
---

<section class="section offers-section" id="offers">
  <div class="container">
    <!-- Header -->
    <div class="offers-header reveal">
      <div class="offers-label-row">
        <span class="offers-fire-badge">🔥 This Week Only</span>
        <span class="offers-divider"></span>
        <span class="offers-sub-label">Limited availability — slots fill fast</span>
      </div>
      <div class="offers-title-row">
        <h2 class="offers-title">
          Try Us for <span class="text-gold-gradient">Free.</span><br />
          Pay When It Works.
        </h2>
        <a href="/offers" class="offers-view-all">
          View All Offers
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll track (full-bleed) -->
  <div class="offers-track-wrap">
    <div class="offers-track" id="offers-track">
      {offers.map((o, i) => (
        <article
          class={`ocard ocard--${o.accent}`}
          data-timer={o.timer ? o.timerHours : null}
          data-timer-id={o.timer ? `timer-${i}` : null}
        >
          <!-- Heat badge -->
          <div class="ocard-heat">{o.heatLabel}</div>

          <!-- Top bar -->
          <div class="ocard-top">
            <span class="ocard-tag">{o.tag}</span>
            {o.spots !== null && (
              <span class="ocard-spots">
                <span class="spots-dot"></span>
                {o.spots} spots left
              </span>
            )}
          </div>

          <!-- Icon + title -->
          <div class="ocard-icon" aria-hidden="true">{o.icon}</div>
          <h3 class="ocard-title">{o.title}</h3>

          <!-- Value -->
          <div class="ocard-value">{o.value}</div>

          <!-- Desc -->
          <p class="ocard-desc">{o.desc}</p>

          <!-- Timer -->
          {o.timer && (
            <div class="ocard-timer" id={`timer-${i}`}>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Expires in </span>
              <strong class="timer-val">--:--:--</strong>
            </div>
          )}

          <!-- Highlight pill -->
          <div class="ocard-highlight">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {o.highlight}
          </div>

          <!-- CTA -->
          <a href="/contact" class="ocard-cta">
            {o.cta}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

          <!-- Accent glow -->
          <div class="ocard-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <!-- Fade edges -->
    <div class="track-fade track-fade--left"  aria-hidden="true"></div>
    <div class="track-fade track-fade--right" aria-hidden="true"></div>
  </div>
</section>

<style>
