  .ocard--purple { --acc: #c4b5fd; --acc-bg: rgba(123,63,160,0.1);  --acc-border: rgba(123,63,160,0.3); }
  .ocard--blue   { --acc: #93c5fd; --acc-bg: rgba(30,77,183,0.1);   --acc-border: rgba(30,77,183,0.3); }
  .ocard--gold   { --acc: #C9A84C; --acc-bg: rgba(201,168,76,0.1);  --acc-border: rgba(201,168,76,0.3); }
  .ocard--green  { --acc: #6ee7b7; --acc-bg: rgba(16,185,129,0.1);  --acc-border: rgba(16,185,129,0.3); }
  .ocard--pink   { --acc: #f9a8d4; --acc-bg: rgba(196,64,128,0.1);  --acc-border: rgba(196,64,128,0.3); }

  .ocard { border-color: var(--acc-border); }
  .ocard-glow { background: var(--acc); }
  .ocard:hover { box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px var(--acc-border), 0 0 40px -10px var(--acc); }

  /* ── Heat badge ───────────────────────────────────────────── */
