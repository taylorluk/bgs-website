<script>
  // ── Auto-scroll ─────────────────────────────────────────────
  const track = document.getElementById('offers-track') as HTMLElement | null;
  if (track) {
    let raf: number;
    let paused = false;
    const SPEED = 0.55; // px per frame

    function scroll() {
      if (!paused) {
        track!.scrollLeft += SPEED;
        // Seamless reset: when we've scrolled past halfway, snap back
        if (track!.scrollLeft >= track!.scrollWidth - track!.clientWidth - 1) {
          track!.scrollLeft = 0;
        }
      }
      raf = requestAnimationFrame(scroll);
    }

    track.addEventListener('mouseenter', () => { paused = true; });
    track.addEventListener('mouseleave', () => { paused = false; });

    // Drag support
    let isDragging = false, startX = 0, startScroll = 0;
    track.addEventListener('mousedown', e => {
      isDragging = true; paused = true;
      startX = e.pageX - track.offsetLeft;
      startScroll = track.scrollLeft;
      track.classList.add('is-dragging');
    });
    window.addEventListener('mouseup', () => {
      isDragging = false;
      track?.classList.remove('is-dragging');
      setTimeout(() => { if (!track?.matches(':hover')) paused = false; }, 800);
    });
    track.addEventListener('mousemove', e => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      track.scrollLeft = startScroll - (x - startX);
    });

    raf = requestAnimationFrame(scroll);
  }

  // ── Countdown timers ────────────────────────────────────────
  interface TimerCard { el: HTMLElement; expires: number; valEl: HTMLElement | null; }
  const timerCards: TimerCard[] = [];

  document.querySelectorAll<HTMLElement>('[data-timer]').forEach(card => {
    const hours = parseFloat(card.dataset.timer ?? '0');
    const timerId = card.dataset.timerId;
    if (!timerId) return;

    // Store expiry in sessionStorage so it persists across page navigations
    const key = `bgs-offer-timer-${timerId}`;
    let expires = parseFloat(sessionStorage.getItem(key) ?? 'NaN');
    if (isNaN(expires) || expires < Date.now()) {
      expires = Date.now() + hours * 3600 * 1000;
      sessionStorage.setItem(key, String(expires));
    }

    const el = document.getElementById(timerId);
    timerCards.push({ el: card, expires, valEl: el?.querySelector('.timer-val') ?? null });
  });

  function pad(n: number) { return String(Math.floor(n)).padStart(2, '0'); }

  function tickTimers() {
    const now = Date.now();
    timerCards.forEach(({ expires, valEl }) => {
      if (!valEl) return;
      const diff = Math.max(0, expires - now);
      const h = diff / 3600000;
      const m = (diff % 3600000) / 60000;
      const s = (diff % 60000) / 1000;
      valEl.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
    });
  }

  tickTimers();
  setInterval(tickTimers, 1000);
</script>
