---
import { imageDims } from '../lib/images.js';
const tiers = [
  {
    num: '01',
    stage: 'Just Launching',
    accent: 'gold',
    tagline: 'You have a vision. We give it a voice.',
    headline: 'Launch with impact from day one.',
    body: "You have a great product but need the world to notice. We build your brand identity, launch strategy, and first campaigns — so you enter the market looking like you've been winning for years.",
    bullets: [
      'Brand identity & positioning built to last',
      'Launch campaigns that generate immediate buzz',
      'Funnels that convert from the very first click',
      'AI-powered content to scale your output fast',
    ],
    metric: { val: '30', unit: 'Days', label: 'to first results' },
    cta: 'Start Strong',
    image: 'https://images.unsplash.com/photo-1553484771-371a605b060b?w=900&h=600&q=80&auto=format&fit=crop',
    imageAlt: 'Entrepreneur at desk planning brand strategy',
  },
  {
    num: '02',
    stage: 'Ready to Scale',
    accent: 'purple',
    tagline: 'Revenue is coming in. Now make it compound.',
    headline: 'Stop leaving money on the table.',
    body: "You're growing but feel like you're operating below your ceiling. Your ads could perform harder, your content could convert better, and your systems are leaking leads. We fix all of it.",
    bullets: [
      'Performance ads optimised for ROAS, not just clicks',
      'Creative that stops the scroll and drives action',
      'CRM & automation that multiplies your team\'s output',
      'Dashboards so you always know what\'s working',
    ],
    metric: { val: '6×', unit: 'ROAS', label: 'avg client return' },
    cta: 'Accelerate Growth',
    image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=900&h=600&q=80&auto=format&fit=crop',
    imageAlt: 'Team reviewing analytics growth charts',
  },
  {
    num: '03',
    stage: 'Established & Ambitious',
    accent: 'pink',
    tagline: 'You\'re winning. Now become untouchable.',
    headline: 'Dominate your category. Own your market.',
    body: "You're a recognised brand with real revenue — but the market moves fast. You need an elite team that owns your entire growth engine: strategy, creative, AI systems, and global expansion.",
    bullets: [
      'Omnichannel strategy that owns your entire category',
      'Brand equity that commands premium pricing',
      'AI and automation deployed at enterprise scale',
      'Global expansion into new markets and territories',
    ],
    metric: { val: '15+', unit: 'Countries', label: 'clients served' },
    cta: 'Dominate Your Market',
    image: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=900&h=600&q=80&auto=format&fit=crop',
    imageAlt: 'Senior executive in premium modern office',
  },
];
---

<section class="section who-section" id="who-is-this-for">
  <!-- Background texture -->
  <div class="who-bg" aria-hidden="true">
    <div class="who-bg-glow who-bg-glow--1"></div>
    <div class="who-bg-glow who-bg-glow--2"></div>
  </div>

  <div class="container">
    <!-- Header -->
    <div class="who-header reveal">
      <p class="who-eyebrow">Who Is This For</p>
      <h2 class="who-title">
        Where Are You<br />
        <span class="text-gold-gradient">on Your Journey?</span>
      </h2>
      <p class="who-sub">Pick your stage. We have a playbook built for exactly where you are — and a track record of getting brands to the next level.</p>
    </div>

    <!-- Stage selector tabs -->
    <div class="who-tabs reveal" role="tablist" aria-label="Business stages">
      {tiers.map((t, i) => (
        <button
          class={`who-tab who-tab--${t.accent}${i === 0 ? ' who-tab--active' : ''}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`stage-panel-${i}`}
          data-tab={i}
        >
          <span class="tab-num">{t.num}</span>
          <span class="tab-stage">{t.stage}</span>
          <span class="tab-bar"><span class="tab-bar-fill"></span></span>
        </button>
      ))}
    </div>

    <!-- Panels -->
    <div class="who-panels">
      {tiers.map((t, i) => (
        <div
          class={`who-panel${i === 0 ? ' who-panel--active' : ''}`}
          id={`stage-panel-${i}`}
          role="tabpanel"
          data-panel={i}
        >
          <!-- Left: image side -->
          <div class="panel-img-col">
            <div class="panel-img-wrap">
              <img
                src={t.image}
                width={imageDims(t.image).width}
                height={imageDims(t.image).height}
                alt={t.imageAlt}
                class="panel-img"
                loading="lazy"
                decoding="async"
              />
              <!-- Colour overlay -->
              <div class={`panel-img-overlay panel-img-overlay--${t.accent}`}></div>

              <!-- Big watermark number -->
              <div class="panel-watermark" aria-hidden="true">{t.num}</div>

              <!-- Stage badge top-left -->
              <div class={`panel-badge panel-badge--${t.accent}`}>
                <span class="badge-pulse"></span>
                {t.stage}
              </div>

              <!-- Metric bottom-right -->
              <div class="panel-metric">
                <span class={`metric-val metric-val--${t.accent}`}>{t.metric.val} <em>{t.metric.unit}</em></span>
                <span class="metric-label">{t.metric.label}</span>
              </div>
            </div>
          </div>

          <!-- Right: content side -->
          <div class="panel-content-col">
            <p class={`panel-tagline panel-tagline--${t.accent}`}>{t.tagline}</p>
            <h3 class="panel-headline">{t.headline}</h3>
            <p class="panel-body">{t.body}</p>

            <ul class="panel-bullets">
              {t.bullets.map(b => (
                <li class="panel-bullet">
                  <span class={`bullet-icon bullet-icon--${t.accent}`} aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </span>
                  {b}
                </li>
              ))}
            </ul>

            <a href="/contact/" class={`panel-cta panel-cta--${t.accent}`}>
              {t.cta}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .who-section {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-void) 0%, #080e20 50%, var(--bg-void) 100%);
  }

  /* ── Background ───────────────────────────────────────────── */
  .who-bg { position: absolute; inset: 0; pointer-events: none; }
  .who-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }
  .who-bg-glow--1 {
    width: 600px; height: 600px;
    top: -100px; right: -150px;
    background: radial-gradient(circle, rgba(201,168,76,0.05) 0%, transparent 70%);
  }
  .who-bg-glow--2 {
    width: 500px; height: 500px;
    bottom: 0; left: -100px;
    background: radial-gradient(circle, rgba(123,63,160,0.06) 0%, transparent 70%);
  }

  /* ── Header ───────────────────────────────────────────────── */
  .who-header {
    text-align: center;
    max-width: 52ch;
    margin: 0 auto 3rem;
  }

  .who-eyebrow {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-primary);
    display: block;
    margin-bottom: 1rem;
  }

  .who-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .who-sub {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* ── Tabs ─────────────────────────────────────────────────── */
  .who-tabs {
    display: flex;
    gap: 0;
    margin-bottom: 2rem;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    overflow: hidden;
    background: rgba(13,27,62,0.4);
  }

  .who-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem 1rem;
    background: none;
    border: none;
    border-right: 1px solid rgba(255,255,255,0.06);
    cursor: pointer;
    position: relative;
    transition: background 0.25s;
    text-align: left;
  }
  .who-tab:last-child { border-right: none; }
  .who-tab:hover { background: rgba(255,255,255,0.03); }

  .who-tab--active { background: rgba(255,255,255,0.04) !important; }

  .tab-num {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--text-dim);
    transition: color 0.25s;
  }

  .tab-stage {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: -0.01em;
    transition: color 0.25s;
  }

  /* Active tab colours */
  .who-tab--gold.who-tab--active .tab-num   { color: var(--gold-primary); }
  .who-tab--gold.who-tab--active .tab-stage { color: var(--gold-light); }
  .who-tab--purple.who-tab--active .tab-num   { color: #c4b5fd; }
  .who-tab--purple.who-tab--active .tab-stage { color: #e0d9ff; }
  .who-tab--pink.who-tab--active .tab-num   { color: #f9a8d4; }
  .who-tab--pink.who-tab--active .tab-stage { color: #fecdd3; }

  /* Progress bar under each tab */
  .tab-bar {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(255,255,255,0.05);
  }
  .tab-bar-fill {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 1px;
    transition: width 0.15s;
  }

  .who-tab--gold.who-tab--active .tab-bar-fill   { background: var(--gold-primary); }
  .who-tab--purple.who-tab--active .tab-bar-fill { background: #a78bfa; }
  .who-tab--pink.who-tab--active .tab-bar-fill   { background: #f9a8d4; }

  /* Animate fill when active */
  .who-tab--active .tab-bar-fill {
    animation: tabFill 5s linear forwards;
  }

  @keyframes tabFill {
    from { width: 0%; }
    to   { width: 100%; }
  }

  /* ── Panels ───────────────────────────────────────────────── */
  .who-panels { position: relative; }

  .who-panel {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.07);
    opacity: 0;
    position: absolute;
    top: 0; left: 0; right: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    min-height: 460px;
  }

  .who-panel--active {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }

  /* ── Image column ─────────────────────────────────────────── */
  .panel-img-col { position: relative; overflow: hidden; }

  .panel-img-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 460px;
    overflow: hidden;
  }

  .panel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }

  .who-panel--active .panel-img { transform: scale(1); }
  .who-panel:hover .panel-img   { transform: scale(1.04); }

  /* Colour tinted overlay */
  .panel-img-overlay {
    position: absolute;
    inset: 0;
  }
  .panel-img-overlay--gold   { background: linear-gradient(135deg, rgba(201,168,76,0.25) 0%, rgba(7,12,30,0.55) 100%); }
  .panel-img-overlay--purple { background: linear-gradient(135deg, rgba(123,63,160,0.3) 0%, rgba(7,12,30,0.55) 100%); }
  .panel-img-overlay--pink   { background: linear-gradient(135deg, rgba(196,64,128,0.28) 0%, rgba(7,12,30,0.55) 100%); }

  /* Watermark number */
  .panel-watermark {
    position: absolute;
    bottom: -20px; right: -10px;
    font-family: var(--font-display);
    font-size: 11rem;
    font-weight: 900;
    line-height: 1;
    color: rgba(255,255,255,0.04);
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.04em;
  }

  /* Stage badge */
  .panel-badge {
    position: absolute;
    top: 1.25rem; left: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .panel-badge--gold   { background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.4); color: var(--gold-light); }
  .panel-badge--purple { background: rgba(123,63,160,0.15); border: 1px solid rgba(123,63,160,0.45); color: #c4b5fd; }
  .panel-badge--pink   { background: rgba(196,64,128,0.15); border: 1px solid rgba(196,64,128,0.4); color: #f9a8d4; }

  .badge-pulse {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: bPulse 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes bPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%       { transform: scale(0.6); opacity: 0.4; }
  }

  /* Metric pill */
  .panel-metric {
    position: absolute;
    bottom: 1.25rem; right: 1.25rem;
    background: rgba(7,12,30,0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 0.75rem 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }

  .metric-val {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }
  .metric-val em { font-size: 0.85rem; font-style: normal; font-weight: 600; }

  .metric-val--gold   { color: var(--gold-light); }
  .metric-val--purple { color: #c4b5fd; }
  .metric-val--pink   { color: #f9a8d4; }

  .metric-label {
    font-size: 0.68rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ── Content column ───────────────────────────────────────── */
  .panel-content-col {
    background: rgba(10,20,50,0.7);
    padding: 3rem 2.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    border-left: 1px solid rgba(255,255,255,0.05);
  }

  .panel-tagline {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .panel-tagline--gold   { color: var(--gold-primary); }
  .panel-tagline--purple { color: #a78bfa; }
  .panel-tagline--pink   { color: #f9a8d4; }

  .panel-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .panel-body {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  /* Bullets */
  .panel-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .panel-bullet {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .bullet-icon {
    width: 20px; height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bullet-icon--gold   { background: rgba(201,168,76,0.12); color: var(--gold-primary); border: 1px solid rgba(201,168,76,0.25); }
  .bullet-icon--purple { background: rgba(123,63,160,0.12); color: #c4b5fd;             border: 1px solid rgba(123,63,160,0.3); }
  .bullet-icon--pink   { background: rgba(196,64,128,0.12); color: #f9a8d4;             border: 1px solid rgba(196,64,128,0.25); }

  /* CTA */
  .panel-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: gap 0.2s, transform 0.2s, box-shadow 0.2s;
    align-self: flex-start;
    border-width: 1px;
    border-style: solid;
  }
  .panel-cta:hover { gap: 0.9rem; transform: translateX(3px); }

  .panel-cta--gold   { background: rgba(201,168,76,0.1);  border-color: rgba(201,168,76,0.35); color: var(--gold-light); }
  .panel-cta--purple { background: rgba(123,63,160,0.12); border-color: rgba(123,63,160,0.4);  color: #c4b5fd; }
  .panel-cta--pink   { background: rgba(196,64,128,0.12); border-color: rgba(196,64,128,0.35); color: #f9a8d4; }

  .panel-cta--gold:hover   { background: rgba(201,168,76,0.2);  box-shadow: 0 0 20px rgba(201,168,76,0.15); }
  .panel-cta--purple:hover { background: rgba(123,63,160,0.22); box-shadow: 0 0 20px rgba(123,63,160,0.2); }
  .panel-cta--pink:hover   { background: rgba(196,64,128,0.2);  box-shadow: 0 0 20px rgba(196,64,128,0.15); }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .who-panel { grid-template-columns: 1fr; }
    .panel-img-wrap { min-height: 280px; }
    .panel-watermark { font-size: 7rem; }
    .panel-content-col { padding: 2rem 1.75rem; border-left: none; border-top: 1px solid rgba(255,255,255,0.05); }
    .who-tabs { flex-direction: column; }
    .who-tab { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06); flex-direction: row; align-items: center; gap: 0.75rem; }
    .who-tab:last-child { border-bottom: none; }
    .tab-bar { top: 0; bottom: auto; left: 0; width: 3px; right: auto; height: 100%; }
  }

  @media (max-width: 600px) {
    .panel-content-col { padding: 1.5rem; }
    .panel-headline { font-size: 1.4rem; }
  }
</style>

<script>
  const tabs  = Array.from(document.querySelectorAll('.who-tab'))   as HTMLElement[];
  const panels = Array.from(document.querySelectorAll('.who-panel')) as HTMLElement[];

  const AUTO_MS = 5000;
  let timer: ReturnType<typeof setTimeout> | null = null;
  let current = 0;

  function activate(idx: number) {
    // Deactivate all
    tabs.forEach(t => {
      t.classList.remove('who-tab--active');
      t.setAttribute('aria-selected', 'false');
      // Restart fill animation by cloning
      const fill = t.querySelector('.tab-bar-fill') as HTMLElement | null;
      if (fill) { fill.style.animation = 'none'; void fill.offsetWidth; fill.style.animation = ''; }
    });
    panels.forEach(p => p.classList.remove('who-panel--active'));

    // Activate target
    tabs[idx].classList.add('who-tab--active');
    tabs[idx].setAttribute('aria-selected', 'true');
    panels[idx].classList.add('who-panel--active');
    current = idx;
  }

  function startAuto() {
    if (timer) clearTimeout(timer);
    timer = setTimeout(() => {
      activate((current + 1) % tabs.length);
      startAuto();
    }, AUTO_MS);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => {
      activate(i);
      startAuto(); // reset timer
    });
  });

  // Boot
  activate(0);
  startAuto();
</script>
