---
---

<section class="hero" id="hero">
  <!-- Aurora background layers -->
  <div class="aurora" aria-hidden="true">
    <div class="aurora-orb aurora-orb--purple"></div>
    <div class="aurora-orb aurora-orb--pink"></div>
    <div class="aurora-orb aurora-orb--amber"></div>
    <div class="aurora-orb aurora-orb--blue"></div>
  </div>

  <!-- Silk texture overlay -->
  <div class="silk-overlay" aria-hidden="true"></div>

  <!-- Grid overlay -->
  <div class="grid-overlay" aria-hidden="true"></div>

  <div class="container hero-layout">
    <!-- LEFT: Copy -->
    <div class="hero-copy">
      <!-- Eyebrow -->
      <div class="hero-eyebrow reveal">
        <span class="eyebrow-dot"></span>
        <span>Dubai-Based · Operating in 15+ Countries</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-headline reveal">
        We Turn Ambitious<br />
        Brands Into<br />
        <span class="text-gold-gradient">Market Leaders</span>
      </h1>

      <!-- Subheadline -->
      <p class="hero-sub reveal">
        BGS Technologies fuses elite strategy, scroll-stopping creative,
        and proprietary AI to drive measurable revenue growth — whether
        you're launching, scaling, or dominating your market.
      </p>

      <!-- CTAs -->
      <div class="hero-ctas reveal">
        <a href="/contact" class="btn-gold">
          Book a Free Strategy Call
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/work" class="btn-ghost">See Client Results</a>
      </div>

      <!-- Micro stats -->
      <div class="hero-stats reveal">
        <div class="hero-stat">
          <strong class="count-up" data-target="50" data-suffix="+">0+</strong>
          <span>Brands Scaled</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="hero-stat">
          <strong class="count-up" data-target="15" data-suffix="+">0+</strong>
          <span>Countries</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="hero-stat">
          <strong>$10M+</strong>
          <span>Ad Spend Managed</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="hero-stat">
          <strong>300%</strong>
          <span>Avg. Client ROAS</span>
        </div>
      </div>
    </div>

    <!-- RIGHT: Performance dashboard visual -->
    <div class="hero-visual reveal-right">
      <div class="dashboard-card">
        <div class="dashboard-glow"></div>

        <!-- Header -->
        <div class="db-header">
          <div class="db-title-group">
            <span class="db-label">Campaign Performance</span>
            <span class="db-sub">Q1 2025 · Fashion Brand, UAE</span>
          </div>
          <span class="db-live">
            <span class="live-dot"></span>
            Live
          </span>
        </div>

        <!-- Primary metric -->
        <div class="db-primary-metric">
          <div class="metric-row">
            <span class="metric-name">ROAS</span>
            <span class="metric-badge">+127% vs target</span>
          </div>
          <div class="metric-value">4.2×</div>
          <div class="metric-bar-wrap">
            <div class="metric-bar" style="width: 84%;"></div>
          </div>
        </div>

        <div class="db-divider"></div>

        <!-- Secondary metrics grid -->
        <div class="db-metrics-grid">
          <div class="db-metric">
            <span class="db-metric-label">Monthly Revenue</span>
            <span class="db-metric-value">$284K</span>
            <span class="db-metric-delta up">▲ 312%</span>
          </div>
          <div class="db-metric">
            <span class="db-metric-label">CAC Reduction</span>
            <span class="db-metric-value">-67%</span>
            <span class="db-metric-delta up">▲ Cost saving</span>
          </div>
          <div class="db-metric">
            <span class="db-metric-label">Click-Through Rate</span>
            <span class="db-metric-value">8.3%</span>
            <span class="db-metric-delta up">▲ 2.1× industry avg</span>
          </div>
          <div class="db-metric">
            <span class="db-metric-label">Leads Generated</span>
            <span class="db-metric-value">2,847</span>
            <span class="db-metric-delta up">▲ In 90 days</span>
          </div>
        </div>

        <div class="db-divider"></div>

        <!-- Mini chart -->
        <div class="db-chart-section">
          <span class="db-chart-label">Revenue Growth</span>
          <div class="db-bars">
            <div class="db-bar" style="height: 25%;"></div>
            <div class="db-bar" style="height: 38%;"></div>
            <div class="db-bar" style="height: 32%;"></div>
            <div class="db-bar" style="height: 52%;"></div>
            <div class="db-bar" style="height: 48%;"></div>
            <div class="db-bar" style="height: 65%;"></div>
            <div class="db-bar" style="height: 60%;"></div>
            <div class="db-bar" style="height: 78%;"></div>
            <div class="db-bar" style="height: 85%;"></div>
            <div class="db-bar db-bar--gold" style="height: 100%;"></div>
          </div>
        </div>

        <!-- Client badges -->
        <div class="db-clients">
          <span class="db-client-badge">Fashion · UAE</span>
          <span class="db-client-badge">SaaS · Global</span>
          <span class="db-client-badge">PropDev · MENA</span>
        </div>
      </div>

      <!-- Floating accent cards -->
      <div class="float-card float-card--top reveal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold-primary)" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        <span>+420% ROAS · 90 days</span>
      </div>
      <div class="float-card float-card--bottom reveal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--purple-light)" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        <span>Results in 30 days</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-hidden="true">
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 72px;
  }

  /* ── Aurora ──────────────────────────────────────────────── */
  .aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    animation: float 12s ease-in-out infinite;
  }

  .aurora-orb--purple {
    width: 55vw; height: 55vw;
    max-width: 700px; max-height: 700px;
    background: radial-gradient(circle, rgba(123, 63, 160, 0.45) 0%, transparent 70%);
    top: -20%; right: -10%;
    animation-duration: 14s;
  }

  .aurora-orb--pink {
    width: 40vw; height: 40vw;
    max-width: 500px; max-height: 500px;
    background: radial-gradient(circle, rgba(196, 64, 128, 0.35) 0%, transparent 70%);
    top: 10%; right: 20%;
    animation-delay: -4s; animation-duration: 11s;
  }

  .aurora-orb--amber {
    width: 30vw; height: 30vw;
    max-width: 400px; max-height: 400px;
    background: radial-gradient(circle, rgba(212, 112, 74, 0.25) 0%, transparent 70%);
    top: 35%; right: 5%;
    animation-delay: -7s; animation-duration: 16s;
  }

  .aurora-orb--blue {
    width: 60vw; height: 60vw;
    max-width: 800px; max-height: 800px;
    background: radial-gradient(circle, rgba(26, 58, 138, 0.4) 0%, transparent 70%);
    bottom: -30%; left: -20%;
    animation-delay: -2s; animation-duration: 18s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%       { transform: translate(3%, -4%) scale(1.05); }
    66%       { transform: translate(-2%, 3%) scale(0.97); }
  }

  /* ── Overlays ────────────────────────────────────────────── */
  .silk-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg,
      rgba(201, 168, 76, 0.04) 0%, transparent 40%,
      rgba(201, 168, 76, 0.03) 60%, transparent 100%);
    pointer-events: none;
  }

  .grid-overlay {
    position: absolute; inset: 0; z-index: 1;
    background-image:
      linear-gradient(rgba(201, 168, 76, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 168, 76, 0.04) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }

  /* ── Layout ──────────────────────────────────────────────── */
  .hero-layout {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 8rem;
  }

  /* ── Copy ────────────────────────────────────────────────── */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    background: rgba(201, 168, 76, 0.08);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    color: var(--gold-primary);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
  }

  .eyebrow-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gold-primary);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(0.7); }
  }

  .hero-headline {
    font-size: clamp(2.6rem, 5.5vw, 5.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--text-muted);
    max-width: 48ch;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-stat strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--gold-primary);
    line-height: 1;
  }

  .hero-stat span {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .stat-divider {
    width: 1px; height: 34px;
    background: var(--border-subtle);
    flex-shrink: 0;
  }

  /* ── Dashboard Visual ────────────────────────────────────── */
  .hero-visual {
    position: relative;
  }

  .dashboard-card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    padding: 2rem;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .dashboard-glow {
    position: absolute;
    top: -80px; right: -80px;
    width: 250px; height: 250px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Dashboard header */
  .db-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .db-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin-bottom: 0.2rem;
  }

  .db-sub {
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .db-live {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.2);
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
  }

  .live-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 1.5s ease-in-out infinite;
  }

  /* Primary metric */
  .db-primary-metric {
    margin-bottom: 1.25rem;
  }

  .metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .metric-name {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .metric-badge {
    font-size: 0.68rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--gold-primary);
    background: rgba(201, 168, 76, 0.1);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--gold-primary);
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  .metric-bar-wrap {
    height: 4px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
  }

  .metric-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--gold-dim), var(--gold-primary));
    border-radius: 2px;
    transition: width 1.5s ease;
  }

  .db-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 1.25rem 0;
  }

  /* Secondary metrics grid */
  .db-metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .db-metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .db-metric-label {
    font-size: 0.68rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .db-metric-value {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .db-metric-delta {
    font-size: 0.68rem;
    font-weight: 600;
    font-family: var(--font-display);
  }

  .db-metric-delta.up { color: #4ade80; }

  /* Mini chart */
  .db-chart-section {
    margin-bottom: 1.25rem;
  }

  .db-chart-label {
    display: block;
    font-size: 0.68rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .db-bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 48px;
  }

  .db-bar {
    flex: 1;
    background: rgba(201, 168, 76, 0.2);
    border-radius: 3px 3px 0 0;
    min-height: 4px;
    transition: height 1s ease;
  }

  .db-bar--gold {
    background: var(--gold-primary);
    box-shadow: 0 0 8px rgba(201, 168, 76, 0.4);
  }

  /* Client badges */
  .db-clients {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .db-client-badge {
    font-size: 0.68rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* Floating accent cards */
  .float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-void);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.6rem 1rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
    backdrop-filter: blur(10px);
    white-space: nowrap;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    z-index: 2;
  }

  .float-card--top {
    top: -1.25rem;
    left: -1.5rem;
  }

  .float-card--bottom {
    bottom: -1.25rem;
    right: -1rem;
  }

  /* ── Scroll indicator ────────────────────────────────────── */
  .scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .scroll-line {
    width: 1px; height: 60px;
    background: linear-gradient(to bottom, var(--gold-primary), transparent);
    margin: 0 auto;
    animation: scrollDown 2s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0%   { opacity: 0; transform: scaleY(0); transform-origin: top; }
    50%  { opacity: 1; transform: scaleY(1); transform-origin: top; }
    100% { opacity: 0; transform: scaleY(1); transform-origin: bottom; }
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding-top: 3rem;
      padding-bottom: 6rem;
    }

    .hero-visual { order: -1; }
    .float-card--top { left: 0; }
    .float-card--bottom { right: 0; }
  }

  @media (max-width: 640px) {
    .hero-stats { gap: 1rem; flex-wrap: wrap; justify-content: center; }
    .hero-stat strong { font-size: 1.4rem; }
    .hero-stat { min-width: 80px; }
    .stat-divider { display: none; }
    .db-metrics-grid { grid-template-columns: 1fr 1fr; }
    .float-card { display: none; }
    .hero-actions { flex-direction: column; width: 100%; }
    .hero-actions .btn-gold,
    .hero-actions .btn-ghost { width: 100%; justify-content: center; }
  }
</style>
