    image: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=700&h=900&q=80&auto=format&fit=crop',
    accent: 'amber',
  },
  {
    brand: 'Vela Wellness',
    category: 'Health & Wellness',
    region: 'UAE & UK',
    service: 'Full-Service · AI Content · Funnels',
    result: '5× Online Revenue',
    resultSub: '22K new customers in year one',
    image: 'https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=700&h=900&q=80&auto=format&fit=crop',
    accent: 'pink',
  },
  {
