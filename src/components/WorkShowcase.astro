    accent: 'gold',
  },
  {
    brand: 'Crest Developments',
    category: 'Real Estate',
    region: 'Dubai & MENA',
    service: 'Lead Gen · Funnels · CRM',
    result: '2,400+ Leads',
    resultSub: 'Across 12 countries in 90 days',
    image: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=700&h=900&q=80&auto=format&fit=crop',
    accent: 'purple',
  },
