---
import BgsMark from '../assets/logo/bgs-mark-gold.svg';
import { SOCIAL_PROFILES } from '../consts.js';
const services = [
  { label: 'Paid Ads', href: '/services#marketing' },
  { label: 'Social Media & Content', href: '/services#marketing' },
  { label: 'Branding & Creative', href: '/services#marketing' },
  { label: 'Web & Funnels', href: '/services#marketing' },
  { label: 'Tech & Automation', href: '/services#technology' },
  { label: 'AI Marketing', href: '/services#ai' },
];

const company = [
  { label: 'About', href: '/about' },
  { label: 'Our Work', href: '/work' },
  { label: 'Blog', href: '/blog' },
  { label: 'Offers', href: '/offers' },
  { label: 'Contact', href: '/contact' },
  { label: 'Book a Call', href: '/contact' },
];

const year = new Date().getFullYear();

---

<footer class="footer">
  <hr class="gold-line" />

  <div class="container footer-inner">
    <!-- Brand -->
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <BgsMark
          class="footer-logo-img"
          width={38}
          height={38}
          role="img"
          aria-label="BGS Technologies"
        />
        <div class="footer-logo-text">
          <span class="logo-bgs">BGS</span>
          <span class="logo-pipe-footer" aria-hidden="true"></span>
          <span class="logo-tech">Marketing | Tech | AI</span>
        </div>
      </a>
      <p class="footer-tagline">Where Strategy Meets Technology.<br />Built for growth. Engineered to last.</p>
      <div class="footer-socials">
        <a href={SOCIAL_PROFILES.linkedin} aria-label="BGS Technologies on LinkedIn" class="social-link" target="_blank" rel="noopener">in</a>
        <a href={SOCIAL_PROFILES.instagram} aria-label="BGS Technologies on Instagram" class="social-link" target="_blank" rel="noopener">ig</a>
      </div>
    </div>

    <!-- Services -->
    <div class="footer-col">
      <h2>Services</h2>
      <ul>
        {services.map(s => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </div>

    <!-- Company -->
    <div class="footer-col">
      <h2>Company</h2>
      <ul>
        {company.map(c => <li><a href={c.href}>{c.label}</a></li>)}
      </ul>
    </div>

    <!-- Contact -->
    <div class="footer-col">
      <h2>Contact</h2>
      <p class="footer-address">205, Damas Tower<br />2nd Al Maktoum Road<br />Riggat Al Buteen, Deira<br />Dubai, UAE</p>
      <a href="tel:+971521456818" class="footer-phone">+971 52 145 6818</a>
      <a href="https://wa.me/971521456818" class="footer-whatsapp" target="_blank" rel="noopener">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp Us
      </a>
      <a href="mailto:hello@bgstech.ae" class="footer-email">hello@bgstech.ae</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} BGS Technologies L.L.C-FZ. All rights reserved.</p>
    <div class="footer-legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
      <button type="button" class="footer-cookie-btn" onclick="window.bgsOpenCookieSettings && window.bgsOpenCookieSettings()">Cookie settings</button>
    </div>
  </div>
</footer>

<style>
  .footer-cookie-btn {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
  }

  .footer-cookie-btn:hover { color: var(--gold-light); }

  .footer {
    padding-top: 0;
    background: var(--bg-void);
    margin-top: 6rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: opacity 0.2s;
  }
  .footer-logo:hover { opacity: 0.85; }

  .footer-logo-img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .footer-logo-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-bgs {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    background: linear-gradient(135deg, #E8D48A 0%, var(--gold-primary) 50%, #B8922E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .logo-pipe-footer {
    display: block;
    width: 1px;
    height: 14px;
    background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.35), transparent);
    flex-shrink: 0;
  }

  .logo-tech {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .footer-socials {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    transition: border-color 0.2s, color 0.2s;
  }
  .social-link:hover { border-color: var(--gold-primary); color: var(--gold-primary); }

  .footer-col h2 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 1.25rem;
  }

  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .footer-col ul a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .footer-col ul a:hover { color: var(--text-primary); }

  .footer-address { color: var(--text-muted); font-size: 0.875rem; line-height: 1.7; margin-bottom: 0.75rem; }
  .footer-phone {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .footer-phone:hover { color: var(--text-primary); }
  .footer-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
    color: #4ade80;
    text-decoration: none;
    font-size: 0.875rem;
    transition: opacity 0.2s;
  }
  .footer-whatsapp:hover { opacity: 0.8; }
  .footer-email {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--gold-primary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .footer-email:hover { color: var(--gold-light); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--border-subtle);
    gap: 1rem;
  }

  .footer-bottom p { color: var(--text-dim); font-size: 0.85rem; }
  .footer-legal { display: flex; gap: 1.5rem; }
  .footer-legal a { color: var(--text-dim); text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
  .footer-legal a:hover { color: var(--text-muted); }

  @media (max-width: 1024px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
