  <!-- ══ FULL-SERVICE BANNER ═══════════════════════════════════════════════════ -->
  <section class="fullsvc-banner">
    <div class="container fullsvc-inner reveal">
      <div class="fullsvc-copy">
        <p class="fullsvc-eyebrow">Can't Decide?</p>
        <h2 class="fullsvc-title">
          Let Us Run Everything.<br />
          <span class="text-gold-gradient">The Full-Service Advantage.</span>
        </h2>
        <p class="fullsvc-desc">
          Our most popular engagement — we become your embedded growth team.
          Marketing, technology, and AI working in concert, all under one account manager,
          one strategy, and one goal: making you the dominant brand in your market.
        </p>
        <div class="fullsvc-features">
          {[
            'Dedicated senior account manager',
            'Monthly strategy sessions',
            'Unlimited creative requests',
