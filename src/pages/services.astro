---

<Layout
  title="Services — Marketing, Technology & AI | BGS Technologies"
  description="Full-service marketing, technology, and AI solutions for ambitious brands. Paid ads, branding, CRM, automation, AI content, and more — all under one roof."
>

  <!-- ══ HERO ══════════════════════════════════════════════════════════════════ -->
  <section class="svc-hero">
    <div class="svc-hero-bg" aria-hidden="true">
      <div class="svc-orb svc-orb--1"></div>
      <div class="svc-orb svc-orb--2"></div>
      <div class="svc-orb svc-orb--3"></div>
      <div class="svc-grid-lines"></div>
    </div>

    <div class="container svc-hero-inner">
      <div class="reveal">
        <p class="svc-eyebrow">What We Do</p>
        <h1 class="svc-hero-title">
          One Agency.<br />
          <span class="text-gold-gradient">Every Edge You Need.</span>
        </h1>
        <p class="svc-hero-sub">
          Marketing that performs. Technology that scales. AI that compounds.
          Three integrated service pillars designed to take your brand from where it is
          to where it should be — faster than you thought possible.
        </p>
      </div>

      <!-- 3-level anchors -->
      <nav class="svc-level-nav reveal" aria-label="Service levels">
        <a href="#marketing" class="level-btn level-btn--gold">
          <span class="level-num">01</span>
          <span class="level-name">Marketing</span>
          <span class="level-count">8 Services</span>
        </a>
        <a href="#technology" class="level-btn level-btn--blue">
          <span class="level-num">02</span>
          <span class="level-name">Technology</span>
          <span class="level-count">6 Services</span>
        </a>
        <a href="#ai" class="level-btn level-btn--purple">
          <span class="level-num">03</span>
          <span class="level-name">Artificial Intelligence</span>
          <span class="level-count">6 Services</span>
        </a>
      </nav>
    </div>
  </section>

  <!-- ══ LEVEL 01: MARKETING ═══════════════════════════════════════════════════ -->
  <section class="svc-level svc-level--marketing" id="marketing">
    <div class="level-header">
      <div class="container">
        <div class="level-header-inner reveal">
          <div class="level-tag level-tag--gold">
            <span>01</span> Marketing
          </div>
          <h2 class="level-title">
            Campaigns That Convert.<br />
            <span class="text-gold-gradient">Brands That Endure.</span>
          </h2>
          <p class="level-sub">
            From the first ad impression to the final purchase — and every touchpoint in between.
            We cover every marketing channel with the depth of a specialist and the breadth of a full team.
          </p>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="svc-grid stagger-children">
        {marketing.map(svc => (
          <article class="svc-card svc-card--marketing">
            {svc.tag && <div class="svc-tag svc-tag--gold">{svc.tag}</div>}
            <div class="svc-card-head">
              <span class="svc-icon" aria-hidden="true">{svc.icon}</span>
              <div>
                <h3 class="svc-title">{svc.title}</h3>
                <p class="svc-tagline">{svc.tagline}</p>
              </div>
            </div>
            <p class="svc-desc">{svc.desc}</p>
            <ul class="svc-deliverables">
              {svc.deliverables.map(d => (
                <li>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {d}
                </li>
              ))}
            </ul>
            <div class="svc-card-footer">
              <span
                class="svc-result"
                style={`color:${resultColors[svc.resultColor as ResultColor].text};background:${resultColors[svc.resultColor as ResultColor].bg};border-color:${resultColors[svc.resultColor as ResultColor].border}`}
              >
                {svc.result}
              </span>
              <a href="/contact" class="svc-cta svc-cta--gold">
                Get Started
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ LEVEL 02: TECHNOLOGY ══════════════════════════════════════════════════ -->
  <section class="svc-level svc-level--tech" id="technology">
    <div class="level-header">
      <div class="container">
        <div class="level-header-inner reveal">
          <div class="level-tag level-tag--blue">
            <span>02</span> Technology
          </div>
          <h2 class="level-title">
            Systems That Scale.<br />
            <span style="background:linear-gradient(135deg,#93c5fd,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
              Tools That Work for You.
            </span>
          </h2>
          <p class="level-sub">
            The best marketing in the world leaks revenue without the right technology behind it.
            We build the systems, automations, and integrations that turn your marketing engine into a revenue machine.
          </p>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="svc-grid stagger-children">
        {technology.map(svc => (
          <article class="svc-card svc-card--tech">
            {svc.tag && <div class="svc-tag svc-tag--blue">{svc.tag}</div>}
            <div class="svc-card-head">
              <span class="svc-icon" aria-hidden="true">{svc.icon}</span>
              <div>
                <h3 class="svc-title">{svc.title}</h3>
                <p class="svc-tagline">{svc.tagline}</p>
              </div>
            </div>
            <p class="svc-desc">{svc.desc}</p>
            <ul class="svc-deliverables">
              {svc.deliverables.map(d => (
                <li>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {d}
                </li>
              ))}
            </ul>
            <div class="svc-card-footer">
              <span
                class="svc-result"
                style={`color:${resultColors[svc.resultColor as ResultColor].text};background:${resultColors[svc.resultColor as ResultColor].bg};border-color:${resultColors[svc.resultColor as ResultColor].border}`}
              >
                {svc.result}
              </span>
              <a href="/contact" class="svc-cta svc-cta--blue">
                Get Started
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ LEVEL 03: AI ══════════════════════════════════════════════════════════ -->
  <section class="svc-level svc-level--ai" id="ai">
    <!-- Scanning beam -->
    <div class="ai-scan" aria-hidden="true"></div>

    <div class="level-header">
      <div class="container">
        <div class="level-header-inner reveal">
          <div class="level-tag level-tag--purple">
            <span>03</span> Artificial Intelligence
          </div>
          <h2 class="level-title">
            Marketing That Thinks.<br />
            <span class="text-aurora-gradient">Results That Compound.</span>
          </h2>
          <p class="level-sub">
            AI isn't a feature we added — it's a capability we built from the ground up.
            Our AI services give you an unfair advantage: more output, sharper targeting,
            and insights that your competitors simply don't have access to.
          </p>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="svc-grid stagger-children">
        {ai.map(svc => (
          <article class="svc-card svc-card--ai">
            {svc.tag && <div class="svc-tag svc-tag--purple">{svc.tag}</div>}
