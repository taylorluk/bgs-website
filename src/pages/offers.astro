---
import Layout from '../layouts/Layout.astro';
import OffersSection from '../components/OffersSection.astro';
import CTA from '../components/CTA.astro';
import { breadcrumbSchema } from '../lib/schema.js';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Offers', path: '/offers/' },
  ]),
];
---

<Layout
  title="Free Trial Offers & Strategy Call | BGS Technologies"
  description="Claim your free 30-minute strategy call, 7-day trial Meta campaign, or brand audit. Limited spots available. BGS Technologies — Dubai's growth agency."
  schemas={schemas}
>
  <div style="padding-top: 72px;">
    <OffersSection headingLevel="h1" showViewAll={false} />
    <CTA />
  </div>
</Layout>
