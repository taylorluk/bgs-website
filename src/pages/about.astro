---
import Layout from '../layouts/Layout.astro';
import { breadcrumbSchema } from '../lib/schema.js';
import CTA from '../components/CTA.astro';

const values = [
  {
    num: '01',
    title: 'Results First. Always.',
    body: "We measure success in revenue, market share, and ROAS — not impressions or vanity metrics. Every decision we make is traced back to one question: does this grow your business?",
    accent: 'gold',
  },
  {
    num: '02',
    title: 'Speed Without Compromise.',
    body: "Great work and fast work are not mutually exclusive. We move at startup velocity with enterprise-level precision. You'll see meaningful results within 30 days — not 30 weeks.",
    accent: 'purple',
  },
  {
    num: '03',
    title: 'Radical Ownership.',
    body: "Your goals are our goals. We don't clock in and clock out. We think about your brand at 11pm because we genuinely care about the outcome — as if it's our own money on the line.",
    accent: 'blue',
  },
  {
    num: '04',
    title: 'Transparent Thinking.',
    body: "No black boxes. No agency jargon. We tell you exactly what we're doing, why we're doing it, and what it's achieving. Complete visibility, always — because trust is built in the details.",
    accent: 'gold',
  },
  {
    num: '05',
    title: 'AI-Native by Design.',
    body: "AI isn't a feature we bolted on — it's embedded in how we think. Every campaign, every workflow, every creative output is amplified by AI that learns and compounds over time.",
    accent: 'purple',
  },
  {
    num: '06',
    title: 'Global by Default.',
    body: "We've scaled brands across 15+ countries from our Dubai base. Our thinking is never constrained by geography — your market is wherever your customers are.",
    accent: 'blue',
  },
];

const stats = [
  { val: 50, suffix: '+', label: 'Brands Scaled' },
  { val: 15, suffix: '+', label: 'Countries Served' },
  { val: 300, suffix: '%', label: 'Avg ROAS Increase' },
  { val: 10, suffix: 'M+', prefix: '$', label: 'Ad Spend Managed' },
  { val: 4.9, suffix: '★', label: 'Client Rating' },
  { val: 48, suffix: 'hrs', label: 'Avg Onboarding Time' },
];

const process = [
  {
    step: '01',
    title: 'Deep Discovery',
    body: 'In the first 48 hours we go deep on your brand, audience, competitors, and current performance. We find the gaps others miss.',
    icon: '🔍',
  },
  {
    step: '02',
    title: 'Growth Blueprint',
    body: "We map your exact path from where you are to where you want to go — channels, budgets, timelines, and KPIs. No guesswork.",
    icon: '🗺️',
  },
  {
    step: '03',
    title: 'Rapid Launch',
    body: 'Campaigns, systems, and creative go live fast. Expect full execution within days, not the 6-week onboarding nightmare other agencies give you.',
    icon: '🚀',
  },
  {
    step: '04',
    title: 'Compound & Scale',
    body: 'We optimise relentlessly. Double down on what works. Unlock new channels. Your results compound month over month — by design.',
    icon: '📈',
  },
];

const team = [
  {
    name: 'Luke Taylor',
    role: 'Founder & CEO',
    bio: 'Serial entrepreneur and marketing strategist with a decade of experience scaling brands across the Middle East, Europe, and beyond.',
    image: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&h=400&q=80&auto=format&fit=crop&fit=faces',
    accent: 'gold',
    linkedin: 'https://www.linkedin.com/company/bgs-technologies',
  },
  {
    name: 'Aisha Rahman',
    role: 'Head of Performance Marketing',
    bio: 'Former Google and Meta partner with 8 years optimising paid campaigns at scale. She has managed over $5M in ad spend across MENA and Europe.',
    image: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=400&h=400&q=80&auto=format&fit=crop&fit=faces',
    accent: 'purple',
    linkedin: 'https://www.linkedin.com/company/bgs-technologies',
  },
  {
    name: 'Marco Bellini',
    role: 'Creative Director',
    bio: 'Award-winning designer and brand strategist who has built visual identities for luxury, hospitality, and technology brands across 12 countries.',
    image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&q=80&auto=format&fit=crop&fit=faces',
    accent: 'blue',
    linkedin: 'https://www.linkedin.com/company/bgs-technologies',
  },
  {
    name: 'Yasmine Al-Farsi',
    role: 'Head of AI & Automation',
    bio: 'AI engineer and automation architect who builds the intelligent systems that give BGS clients an unfair advantage — from chatbots to predictive targeting.',
    image: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&h=400&q=80&auto=format&fit=crop&fit=faces',
    accent: 'gold',
    linkedin: 'https://www.linkedin.com/company/bgs-technologies',
  },
];

const accentMap: Record<string, { text: string; bg: string; border: string }> = {
  gold:   { text: 'var(--gold-primary)',  bg: 'rgba(201,168,76,0.08)',  border: 'rgba(201,168,76,0.2)' },
  purple: { text: '#a78bfa',              bg: 'rgba(123,63,160,0.1)',   border: 'rgba(123,63,160,0.25)' },
  blue:   { text: '#93c5fd',              bg: 'rgba(30,77,183,0.08)',   border: 'rgba(30,77,183,0.2)' },
};

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];

---

<Layout
  title="About BGS Technologies — Dubai's Premier Growth Agency"
  description="Learn how BGS Technologies was built to make elite marketing accessible to every ambitious brand. Our story, our values, and the team behind your results."

  schemas={schemas}
>
  <!-- ══════════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════════ -->
  <section class="about-hero">
    <!-- Background elements -->
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-orb hero-orb--1"></div>
      <div class="hero-orb hero-orb--2"></div>
      <div class="hero-grid"></div>
    </div>

    <div class="container hero-inner">
      <!-- Left: copy -->
      <div class="hero-copy">
        <div class="hero-eyebrow reveal">
          <span class="eyebrow-line"></span>
          <span>Our Story</span>
        </div>

        <h1 class="hero-headline reveal">
          We Build Brands<br />
          <span class="text-gold-gradient">the Market Can't<br />Ignore.</span>
        </h1>

        <p class="hero-sub reveal">
          Born in Dubai. Built for the world. Obsessed with your results.
          BGS Technologies is a full-service growth agency that combines
          elite strategy, AI-powered execution, and creative that actually converts.
        </p>

        <div class="hero-badges reveal">
          <span class="hero-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            UAE Licensed & Regulated
          </span>
          <span class="hero-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            15+ Countries Served
          </span>
          <span class="hero-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            4.9★ Client Rated
          </span>
        </div>

        <div class="hero-actions reveal">
          <a href="/contact" class="btn-gold">
            Book a Free Strategy Call
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#our-story" class="btn-ghost">
            Our Story
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right: image -->
      <div class="hero-visual reveal-right">
        <div class="hero-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=900&h=700&q=85&auto=format&fit=crop"
            alt="Dubai skyline — BGS Technologies HQ"
            class="hero-img"
            width="900"
            height="700"
            loading="eager"
            decoding="async"
          />
          <div class="hero-img-overlay"></div>

          <!-- Floating stat cards -->
          <div class="float-card float-card--1">
            <span class="fc-val">$10M+</span>
            <span class="fc-label">Ad Spend Managed</span>
          </div>
          <div class="float-card float-card--2">
            <span class="fc-val">300%</span>
            <span class="fc-label">Avg ROAS Increase</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       MANIFESTO STRIP
  ══════════════════════════════════════════════════════════ -->
  <section class="manifesto-section">
    <div class="manifesto-inner">
      <p class="manifesto-text reveal">
        "Every ambitious brand deserves world-class marketing.
        The kind that drives real revenue, builds lasting equity,
        and compounds over time.<br />
        <em>That's why BGS Technologies exists.</em>"
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       THE STORY
  ══════════════════════════════════════════════════════════ -->
  <section class="section story-section" id="our-story">
    <div class="container story-grid">
      <!-- Image side -->
      <div class="story-img-col reveal-left">
        <div class="story-img-wrap">
          <img
            src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=800&h=700&q=80&auto=format&fit=crop"
            alt="BGS Technologies team at work"
            class="story-img"
            width="800"
            height="700"
            loading="lazy"
            decoding="async"
          />
          <div class="story-img-accent" aria-hidden="true"></div>
          <!-- Dubai location badge -->
          <div class="story-location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s-8-5.7-8-12a8 8 0 1 1 16 0c0 6.3-8 12-8 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            Dubai, UAE
          </div>
        </div>
      </div>

      <!-- Copy side -->
      <div class="story-copy reveal">
        <p class="story-eyebrow">How It Started</p>
        <h2 class="story-title">
          A City That Doesn't<br />
          <span class="text-gold-gradient">Accept Second Place.</span>
        </h2>

        <div class="story-body">
          <p>
            BGS Technologies was founded in Dubai — a city built on audacity. A city where
            impossible becomes normal before breakfast. That energy didn't just influence us.
            It defined us.
          </p>
          <p>
            We saw too many great businesses fail not because their product was wrong, but
            because their marketing was — average agencies, recycled strategies, zero accountability.
            We believed there was a better way: an agency that thinks like an investor, moves
            like a startup, and delivers like the world-class teams that only the Fortune 500
            could previously afford.
          </p>
          <p>
            So we built it. BGS Technologies is that agency — combining deep performance
            expertise, proprietary AI tools, and creative that stops people mid-scroll.
            Today we operate across 15+ countries, managing campaigns for brands that want
            to dominate their category — not just participate in it.
          </p>
        </div>

        <div class="story-milestones">
          <div class="milestone">
            <span class="milestone-year">2020</span>
            <span class="milestone-event">Founded in Dubai</span>
          </div>
          <div class="milestone">
            <span class="milestone-year">2021</span>
            <span class="milestone-event">Expanded to MENA & Europe</span>
          </div>
          <div class="milestone">
            <span class="milestone-year">2023</span>
            <span class="milestone-event">AI capabilities launched</span>
          </div>
          <div class="milestone">
            <span class="milestone-year">2024</span>
            <span class="milestone-event">50+ brands, 15+ countries</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       STATS
  ══════════════════════════════════════════════════════════ -->
  <section class="stats-bar-section">
    <div class="container">
      <div class="stats-bar stagger-children">
        {stats.map((s) => (
          <div class="stat-item">
            <span
              class="stat-val count-up"
              data-target={s.val}
              data-suffix={s.suffix}
              data-prefix={s.prefix ?? ''}
            >
              {s.prefix ?? ''}{s.val}{s.suffix}
            </span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       VALUES
  ══════════════════════════════════════════════════════════ -->
  <section class="section values-section" id="values">
    <div class="container">
      <div class="values-header reveal">
        <p class="section-eyebrow">What We Stand For</p>
        <h2 class="values-title">
          Six Principles That Drive<br />
          <span class="text-aurora-gradient">Everything We Do</span>
        </h2>
      </div>

      <div class="values-grid stagger-children">
        {values.map((v) => (
          <div class={`value-card value-card--${v.accent}`}>
            <div class="value-num">{v.num}</div>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-body">{v.body}</p>
            <div class="value-line" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       PROCESS
  ══════════════════════════════════════════════════════════ -->
  <section class="section process-section" id="process">
    <div class="container">
      <div class="process-header reveal">
        <p class="section-eyebrow">How We Work</p>
        <h2 class="process-title">
          From Day One to<br />
          <span class="text-gold-gradient">Market Dominance.</span>
        </h2>
        <p class="process-sub">
          No 6-week onboarding. No strategy decks that gather dust.
          Just clear, fast, accountable execution from the moment you say yes.
        </p>
      </div>

      <div class="process-steps stagger-children">
        {process.map((p, i) => (
          <div class="process-step">
            <div class="step-connector" aria-hidden="true">
              <div class="step-icon">{p.icon}</div>
              {i < process.length - 1 && <div class="step-line"></div>}
            </div>
            <div class="step-body">
              <span class="step-num">{p.step}</span>
              <h3 class="step-title">{p.title}</h3>
              <p class="step-desc">{p.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       GLOBAL REACH
  ══════════════════════════════════════════════════════════ -->
  <section class="section global-section" id="global">
    <div class="container global-inner">
      <div class="global-copy reveal">
        <p class="section-eyebrow">Global Reach</p>
        <h2 class="global-title">
          Dubai is Our Home.<br />
          <span class="text-gold-gradient">The World is Our Market.</span>
        </h2>
        <p class="global-body">
          We work with brands across the UAE, GCC, UK, Europe, North America,
          Africa, and Southeast Asia. Geography has never limited what we can
          build for you — our strategies are global from day one.
        </p>
        <div class="global-regions">
          {['UAE & GCC', 'United Kingdom', 'Europe', 'North America', 'Africa', 'Southeast Asia'].map(r => (
            <span class="global-region">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="var(--gold-primary)" stroke="none"><circle cx="12" cy="12" r="10"/></svg>
              {r}
            </span>
          ))}
        </div>
      </div>

      <div class="global-visual reveal-right">
        <div class="globe-card">
          <div class="globe-img-wrap">
            <img
              src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=700&h=500&q=80&auto=format&fit=crop"
              alt="Global business operations"
              class="globe-img"
            width="700"
            height="500"
              loading="lazy"
              decoding="async"
            />
            <div class="globe-overlay"></div>
          </div>
          <div class="globe-stats">
            <div class="globe-stat">
              <span class="gs-val">15+</span>
              <span class="gs-label">Countries</span>
            </div>
            <div class="globe-stat-divider"></div>
            <div class="globe-stat">
              <span class="gs-val">50+</span>
              <span class="gs-label">Brands</span>
            </div>
            <div class="globe-stat-divider"></div>
            <div class="globe-stat">
              <span class="gs-val">3</span>
              <span class="gs-label">Continents</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTA />
</Layout>

<style>
  /* ══ HERO ═══════════════════════════════════════════════════ */
  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 72px;
    overflow: hidden;
  }

  .hero-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }
  .hero-orb--1 {
    width: 700px; height: 700px;
    top: -200px; left: -200px;
    background: radial-gradient(circle, rgba(201,168,76,0.07) 0%, transparent 70%);
  }
  .hero-orb--2 {
    width: 600px; height: 600px;
    bottom: -100px; right: -100px;
    background: radial-gradient(circle, rgba(123,63,160,0.08) 0%, transparent 70%);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(201,168,76,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201,168,76,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 70% at 20% 50%, black 30%, transparent 100%);
  }

  .hero-inner {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 1.5rem;
  }
  .eyebrow-line {
    display: block;
    width: 32px; height: 1px;
    background: var(--gold-primary);
    opacity: 0.6;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 46ch;
    margin-bottom: 1.75rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--gold-primary);
    background: rgba(201,168,76,0.07);
    border: 1px solid rgba(201,168,76,0.2);
    border-radius: 100px;
    padding: 0.3rem 0.85rem;
  }
  .hero-badge svg { flex-shrink: 0; }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, gap 0.2s;
  }
  .btn-ghost:hover { color: var(--text-primary); border-color: rgba(255,255,255,0.25); gap: 0.75rem; }

  /* Hero image */
  .hero-visual { position: relative; }

  .hero-img-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 40px 120px rgba(0,0,0,0.5);
  }

  .hero-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
  }

  .hero-img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(7,12,30,0.3) 0%, rgba(7,12,30,0.1) 100%);
  }

  /* Floating stat cards */
  .float-card {
    position: absolute;
    background: rgba(7,12,30,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(201,168,76,0.25);
    border-radius: 12px;
    padding: 0.85rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    animation: floatBob 4s ease-in-out infinite alternate;
  }
  .float-card--1 { bottom: 2.5rem; left: -1.5rem; animation-delay: 0s; }
  .float-card--2 { top: 2rem; right: -1.5rem; animation-delay: -2s; }

  @keyframes floatBob {
    from { transform: translateY(0px); }
    to   { transform: translateY(-10px); }
  }

  .fc-val {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .fc-label {
    font-size: 0.68rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* ══ MANIFESTO ═══════════════════════════════════════════════ */
  .manifesto-section {
    background: linear-gradient(135deg, rgba(201,168,76,0.06) 0%, rgba(123,63,160,0.06) 100%);
    border-top: 1px solid rgba(201,168,76,0.1);
    border-bottom: 1px solid rgba(201,168,76,0.1);
    padding: 5rem 0;
  }

  .manifesto-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
  }

  .manifesto-text {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    font-style: italic;
