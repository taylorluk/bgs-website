---
import { imageDims } from '../lib/images.js';
import Layout from '../layouts/Layout.astro';
import allPosts from '../data/posts.js';
import { breadcrumbSchema, collectionPageSchema } from '../lib/schema.js';

const posts = allPosts;

const featuredPost = posts.find(p => p.featured);
const gridPosts = posts.filter(p => !p.featured);

const schemas = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
  collectionPageSchema({
    name: 'BGS Technologies Blog',
    description: 'Marketing strategy, AI, paid ads, and branding insights from the BGS Technologies team.',
    path: '/blog',
    items: posts,
    itemPath: (post: any) => `/blog/${post.slug}`,
  }),
];

const categoryColors: Record<string, string> = {
  'Paid Advertising': 'gold',
  'AI & Technology': 'purple',
  'Branding': 'pink',
  'Automation': 'blue',
  'Marketing Strategy': 'teal',
  'E-Commerce': 'orange',
  'Content Marketing': 'cyan',
  'Conversion Optimisation': 'orange',
  'Marketing Automation': 'blue',
  'Video Marketing': 'pink',
  'Agency Insights': 'teal',
  'Lead Generation': 'gold',
  'SEO': 'teal',
  'Social Media': 'pink',
  'Web Design': 'blue',
  'Email Marketing': 'purple',
};
---

<Layout
  title="Blog — Growth Insights from BGS Technologies"
  description="Marketing strategy, AI, paid ads, and branding insights from the BGS Technologies team. Ideas that drive real business growth."
  schemas={schemas}
>

  <!-- ── HERO ───────────────────────────────────────────────────────────────── -->
  <section class="blog-hero">
    <div class="hero-orb hero-orb--purple" aria-hidden="true"></div>
    <div class="hero-orb hero-orb--gold" aria-hidden="true"></div>

    <div class="container hero-inner">
      <p class="eyebrow reveal">The BGS Blog</p>
      <h1 class="hero-headline reveal">
        Ideas That Drive <span class="text-aurora-gradient">Growth</span>
      </h1>
      <p class="hero-sub reveal">
        Strategy, AI, marketing, and technology insights from the team behind 50+ scaled brands.
      </p>

      <!-- Category filter pills -->
      <nav class="category-pills reveal" aria-label="Filter by category">
        <a href="/blog" class="pill pill--active">All</a>
        <a href="/blog" class="pill">Paid Ads</a>
        <a href="/blog" class="pill">AI</a>
        <a href="/blog" class="pill">Branding</a>
        <a href="/blog" class="pill">Automation</a>
        <a href="/blog" class="pill">Strategy</a>
      </nav>
    </div>
  </section>

  <!-- ── FEATURED POST ──────────────────────────────────────────────────────── -->
  {featuredPost && (
    <section class="featured-section section">
      <div class="container">
        <p class="section-label reveal">Featured Article</p>

        <a href={`/blog/${featuredPost.slug}`} class="featured-card reveal">
          <div class="featured-image-wrap">
            <img
              src={featuredPost.image}
              width={imageDims(featuredPost.image).width}
              height={imageDims(featuredPost.image).height}
              alt={featuredPost.title}
              class="featured-image"
              loading="eager"
            />
            <div class="featured-image-overlay" aria-hidden="true"></div>
          </div>
          <div class="featured-content">
            <div class="featured-meta">
              <span class={`cat-badge cat--${categoryColors[featuredPost.category] || 'gold'}`}>
                {featuredPost.category}
              </span>
              <span class="read-time">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {featuredPost.readTime} read
              </span>
            </div>
            <h2 class="featured-title">{featuredPost.title}</h2>
            <p class="featured-excerpt">{featuredPost.excerpt}</p>
            <div class="featured-footer">
              <time class="post-date" datetime={featuredPost.datePublished}>{featuredPost.date}</time>
              <span class="read-link">Read Article →</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ── POSTS GRID ─────────────────────────────────────────────────────────── -->
  <section class="posts-section section">
    <div class="container">
      <p class="section-label reveal">Latest Articles</p>

      <div class="posts-grid stagger-children">
        {gridPosts.map(post => (
          <a href={`/blog/${post.slug}`} class="post-card">
            <div class="post-image-wrap">
              <img
                src={post.image}
                width={imageDims(post.image).width}
                height={imageDims(post.image).height}
                alt={post.title}
                class="post-image"
                loading="lazy"
              />
            </div>
            <div class="post-body">
              <div class="post-meta">
                <span class={`cat-badge cat--${categoryColors[post.category] || 'gold'}`}>
                  {post.category}
                </span>
                <span class="read-time">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {post.readTime}
                </span>
              </div>
              <h3 class="post-title">{post.title}</h3>
              <p class="post-excerpt">{post.excerpt}</p>
              <div class="post-footer">
                <time class="post-date" datetime={post.datePublished}>{post.date}</time>
                <span class="read-link">Read →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── NEWSLETTER CTA ─────────────────────────────────────────────────────── -->
  <section class="newsletter-section">
    <div class="newsletter-bg" aria-hidden="true">
      <div class="newsletter-orb newsletter-orb--purple"></div>
      <div class="newsletter-orb newsletter-orb--gold"></div>
    </div>
    <div class="container newsletter-inner">
      <div class="newsletter-copy reveal">
        <p class="eyebrow">Stay Ahead</p>
        <h2 class="newsletter-title">Get Growth Insights Direct<br />to Your Inbox</h2>
        <p class="newsletter-sub">No spam. Unsubscribe any time.</p>
      </div>
      <form class="newsletter-form reveal-right" name="newsletter" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="newsletter" />
        <div class="newsletter-input-row">
          <input
            type="email"
            name="email"
            placeholder="Enter your email address"
            required
            class="newsletter-input"
          />
          <button type="submit" class="btn-gold newsletter-btn">Subscribe</button>
        </div>
        <p class="newsletter-fine">Join 2,000+ marketers and founders receiving weekly insights.</p>
      </form>
    </div>
  </section>

</Layout>

<style>
  /* ── HERO ─────────────────────────────────────────────────────────────────── */
  .blog-hero {
    position: relative;
    padding-top: 72px;
    min-height: 360px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg-void);
    text-align: center;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }
  .hero-orb--purple {
    width: 550px; height: 550px;
    background: radial-gradient(circle, rgba(123, 63, 160, 0.2) 0%, transparent 70%);
    top: -200px; right: -80px;
  }
  .hero-orb--gold {
    width: 280px; height: 280px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
    bottom: -60px; left: 20%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 3.5rem;
    padding-bottom: 3rem;
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 1rem;
    display: block;
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    display: block;
  }

  .hero-headline {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1.1rem;
  }

  .hero-sub {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 auto 2rem;
  }

  /* Category pills */
  .category-pills {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .pill {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border-radius: 100px;
    border: 1px solid var(--border-subtle);
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .pill:hover {
    border-color: var(--gold-primary);
    color: var(--gold-light);
    background: rgba(201, 168, 76, 0.06);
  }
  .pill--active {
    border-color: var(--gold-primary);
    background: rgba(201, 168, 76, 0.1);
    color: var(--gold-light);
  }

  /* ── CATEGORY BADGE COLOURS ──────────────────────────────────────────────── */
  .cat-badge {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cat--gold {
    background: rgba(201, 168, 76, 0.14);
    color: var(--gold-light);
    border: 1px solid rgba(201, 168, 76, 0.3);
  }
  .cat--purple {
    background: rgba(123, 63, 160, 0.16);
    color: var(--purple-light);
    border: 1px solid rgba(123, 63, 160, 0.35);
  }
  .cat--pink {
    background: rgba(196, 64, 128, 0.14);
    color: #e06fa0;
    border: 1px solid rgba(196, 64, 128, 0.3);
  }
  .cat--blue {
    background: rgba(26, 58, 138, 0.25);
    color: #6ea6f0;
    border: 1px solid rgba(26, 100, 200, 0.35);
  }
  .cat--teal {
    background: rgba(20, 160, 130, 0.14);
    color: #4ecdc4;
    border: 1px solid rgba(20, 160, 130, 0.3);
  }
  .cat--orange {
    background: rgba(212, 112, 74, 0.14);
    color: #e09068;
    border: 1px solid rgba(212, 112, 74, 0.3);
  }
  .cat--cyan {
    background: rgba(20, 180, 200, 0.12);
    color: #56c9d4;
    border: 1px solid rgba(20, 180, 200, 0.28);
  }

  /* ── FEATURED POST ────────────────────────────────────────────────────────── */
  .featured-section {
    background: var(--bg-void);
    padding-top: 2rem;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 60fr 40fr;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    text-decoration: none;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
    min-height: 420px;
  }
  .featured-card:hover {
    border-color: var(--border-gold);
    box-shadow: 0 0 60px rgba(201, 168, 76, 0.1);
    transform: translateY(-3px);
  }

  .featured-image-wrap {
    position: relative;
    overflow: hidden;
  }

  .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .featured-card:hover .featured-image {
    transform: scale(1.04);
  }

  .featured-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 60%, var(--bg-surface));
  }

  .featured-content {
    padding: 2.5rem 2.5rem 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .read-time {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .featured-title {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .featured-excerpt {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .read-link {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--gold-primary);
    transition: color 0.2s;
  }
  .featured-card:hover .read-link,
  .post-card:hover .read-link {
    color: var(--gold-light);
  }

  /* ── POSTS GRID ──────────────────────────────────────────────────────────── */
  .posts-section {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .post-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  .post-card:hover {
    border-color: var(--border-gold);
    box-shadow: 0 0 40px rgba(201, 168, 76, 0.1);
    transform: translateY(-4px);
  }

  .post-image-wrap {
    height: 200px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .post-card:hover .post-image {
    transform: scale(1.05);
  }

  .post-body {
    padding: 1.4rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .post-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
    letter-spacing: -0.015em;
    margin-bottom: 0.65rem;
  }

  .post-excerpt {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
    margin-bottom: 1rem;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  /* ── NEWSLETTER ───────────────────────────────────────────────────────────── */
  .newsletter-section {
    position: relative;
    padding: 6rem 0;
    overflow: hidden;
    background: var(--bg-void);
    border-top: 1px solid var(--border-subtle);
  }

  .newsletter-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .newsletter-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
  }
  .newsletter-orb--purple {
    width: 450px; height: 450px;
    background: radial-gradient(circle, rgba(123, 63, 160, 0.18) 0%, transparent 70%);
    top: -150px; left: -80px;
  }
  .newsletter-orb--gold {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.12) 0%, transparent 70%);
    bottom: -100px; right: 10%;
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .newsletter-title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .newsletter-sub {
    color: var(--text-dim);
    font-size: 0.88rem;
    margin-top: 0.6rem;
  }

  .newsletter-input-row {
    display: flex;
    gap: 0.75rem;
  }

  .newsletter-input {
    flex: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.92rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .newsletter-input::placeholder { color: var(--text-dim); }
  .newsletter-input:focus {
    border-color: var(--gold-primary);
    box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.1);
  }

  .newsletter-btn {
    white-space: nowrap;
    flex-shrink: 0;
    border: none;
  }

  .newsletter-fine {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-top: 0.75rem;
  }

  /* ── RESPONSIVE ─────────────────────────────────────────────────────────────*/
  @media (max-width: 1024px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
    .featured-card { grid-template-columns: 1fr; }
    .featured-image-wrap { height: 260px; }
    .featured-image-overlay { background: linear-gradient(to bottom, transparent 50%, var(--bg-surface)); }
    .featured-content { padding: 2rem; }
    .newsletter-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  @media (max-width: 640px) {
    .posts-grid { grid-template-columns: 1fr; }
    .newsletter-input-row { flex-direction: column; }
    .newsletter-btn { width: 100%; justify-content: center; }
    .category-pills { gap: 0.4rem; }
  }
</style>

<script is:inline>
  document.querySelector('.newsletter-form')?.addEventListener('submit', () => {
    window.posthog?.capture('newsletter_subscribed');
  });
</script>
