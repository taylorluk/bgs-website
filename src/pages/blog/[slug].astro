---
import Layout from '../../layouts/Layout.astro';
import allPosts from '../../data/posts.js';

export function getStaticPaths() {
  return allPosts.map((p: any) => ({ params: { slug: p.slug } }));
}

const posts = allPosts;

const { slug } = Astro.params;
const post = posts.find(p => p.slug === slug);

if (!post) return Astro.redirect('/blog');
---

<Layout
  title={`${post.title} | BGS Technologies Blog`}
  description={post.excerpt}
>
  <article class="post-page">

    <!-- Hero -->
    <div class="post-hero">
      <div class="hero-orb orb--purple" aria-hidden="true"></div>
      <div class="hero-orb orb--gold" aria-hidden="true"></div>
      <div class="container post-hero-inner">
        <div class="post-meta reveal">
          <a href="/blog" class="back-link">← All Articles</a>
          <span class="post-category">{post.category}</span>
          <span class="post-read-time">{post.readTime} read</span>
        </div>
        <h1 class="post-title reveal">{post.title}</h1>
        <div class="post-byline reveal">
          <span class="post-author">{post.author ?? 'BGS Marketing Team'}</span>
          <span class="byline-sep">·</span>
          <span class="post-date">{post.date}</span>
        </div>
      </div>
    </div>

    <!-- Cover Image -->
    <div class="container">
      <div class="post-cover reveal">
        <img
          src={post.image}
          alt={post.title}
          class="cover-img"
          loading="eager"
        />
      </div>
    </div>

    <!-- Content -->
    <div class="container post-layout">
      <div class="post-body">
        <p class="post-lead">{post.excerpt}</p>

        <div class="post-content" set:html={post.body} />

        <!-- Related topics CTA -->
        <div class="post-topics">
          <p class="topics-label">Related Services</p>
          <div class="topics-list">
            <a href="/services" class="topic-tag">View All Services</a>
            <a href="/offers" class="topic-tag">Current Offers</a>
            <a href="/work" class="topic-tag">Our Work</a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="post-sidebar">
        <div class="sidebar-card">
          <p class="sidebar-label">Talk to an Expert</p>
          <h3 class="sidebar-title">Get a personalised strategy for your business</h3>
          <p class="sidebar-desc">Book a free 30-minute call with one of our senior strategists. No pitch, no commitment — just real insights.</p>
          <a href="/contact" class="btn-gold sidebar-cta">Book Free Call →</a>
          <a href="https://wa.me/971521456818" class="whatsapp-cta" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>

        <div class="sidebar-card sidebar-card--services">
          <p class="sidebar-label">Our Services</p>
          <ul class="sidebar-links">
            <li><a href="/services#marketing">Paid Advertising</a></li>
            <li><a href="/services#marketing">Social Media</a></li>
            <li><a href="/services#marketing">Branding & Creative</a></li>
            <li><a href="/services#technology">CRM & Automation</a></li>
            <li><a href="/services#ai">AI Marketing</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Layout>

<style>
  .post-page { padding-bottom: 6rem; }

  /* Hero */
  .post-hero {
    position: relative;
    padding-top: 72px;
    background: var(--bg-void);
    overflow: hidden;
  }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }
  .orb--purple {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(123,63,160,0.2) 0%, transparent 70%);
    top: -150px; left: -100px;
  }
  .orb--gold {
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(201,168,76,0.1) 0%, transparent 70%);
    top: -50px; right: -50px;
  }
  .post-hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 3rem;
    padding-bottom: 3rem;
    max-width: 860px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--gold-primary); }
  .post-category {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-primary);
    background: rgba(201,168,76,0.08);
    border: 1px solid rgba(201,168,76,0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }
  .post-read-time {
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  .post-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .post-byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  .post-author { color: var(--gold-primary); font-weight: 500; }
  .byline-sep { color: var(--text-dim); }
  .post-date {
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  /* Cover */
  .post-cover {
    margin: 2rem 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }
  .cover-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  /* Layout */
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
    margin-top: 3rem;
  }

  /* Body */
  .post-lead {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Article prose */
  .post-content {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }
  .post-content :global(h2) {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .post-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .post-content :global(a) {
    color: var(--gold-primary);
    text-decoration: underline;
    transition: color 0.2s;
  }
  .post-content :global(a:hover) { color: var(--gold-light); }

  /* Topics */
  .post-topics { margin-top: 2rem; }
  .topics-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .topics-list { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .topic-tag {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .topic-tag:hover { border-color: var(--gold-primary); color: var(--gold-primary); }

  /* Sidebar */
  .post-sidebar { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 1.5rem; }
  .sidebar-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.75rem;
  }
  .sidebar-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.75rem;
  }
  .sidebar-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .sidebar-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .sidebar-cta { width: 100%; justify-content: center; margin-bottom: 0.75rem; }
  .whatsapp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #4ade80;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .whatsapp-cta:hover { opacity: 0.8; }

  .sidebar-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sidebar-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sidebar-links a::before { content: '→'; color: var(--gold-primary); font-size: 0.8rem; }
  .sidebar-links a:hover { color: var(--text-primary); }

  /* Responsive */
  @media (max-width: 1024px) {
    .post-layout { grid-template-columns: 1fr; gap: 3rem; }
    .post-sidebar { position: static; }
  }
  @media (max-width: 640px) {
    .cover-img { height: 240px; }
    .post-meta { gap: 0.6rem; }
    .cs-actions { flex-direction: column; }
    .cs-actions a { width: 100%; justify-content: center; }
  }
</style>
