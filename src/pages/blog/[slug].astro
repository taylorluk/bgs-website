---
import Layout from '../../layouts/Layout.astro';
import allPosts from '../../data/posts.js';
import allServices from '../../data/services.js';
import { relatedPosts, servicesForPost, isPillar, pillarFor, spokesOfPillar } from '../../lib/related.js';
import { blogPostingSchema, breadcrumbSchema } from '../../lib/schema.js';

export function getStaticPaths() {
  return allPosts.map((p: any) => ({ params: { slug: p.slug } }));
}

const posts = allPosts;

const { slug } = Astro.params;
const post = posts.find(p => p.slug === slug);

if (!post) return Astro.redirect('/blog/');

const path = `/blog/${post.slug}/`;
const related = relatedPosts(post, posts, 3);
const relatedServices = servicesForPost(post, allServices, 4);

const thisIsPillar = isPillar(post);
const pillarSlug = pillarFor(post);
const pillarPost = pillarSlug ? posts.find(p => p.slug === pillarSlug) : null;
const guideSpokes = thisIsPillar ? spokesOfPillar(post, posts) : [];

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schemas = [
  blogPostingSchema(post, path),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: post.title, path },
  ]),
];
---

<Layout
  title={`${post.metaTitle ?? post.title} | BGS`}
  description={post.excerpt}
  ogImage={post.image}
  ogType="article"
  schemas={schemas}
>
  <article class="post-page">

    <!-- Hero -->
    <div class="post-hero">
      <div class="hero-orb orb--purple" aria-hidden="true"></div>
      <div class="hero-orb orb--gold" aria-hidden="true"></div>
      <div class="container post-hero-inner">
        <div class="post-meta reveal">
          <a href="/blog/" class="back-link">← All Articles</a>
          <span class="post-category">{post.category}</span>
          <span class="post-read-time">{post.readTime} read</span>
        </div>
        <h1 class="post-title reveal">{post.title}</h1>
        <div class="post-byline reveal">
          <span class="post-author">{post.author ?? 'BGS Marketing Team'}</span>
          <span class="byline-sep">·</span>
          <time class="post-date" datetime={post.datePublished}>{post.date}</time>
          {post.dateModified && post.dateModified !== post.datePublished && (
            <>
              <span class="byline-sep">·</span>
              <span class="post-updated">
                Updated <time datetime={post.dateModified}>{formatDate(post.dateModified)}</time>
              </span>
            </>
          )}
        </div>
      </div>
    </div>

    <!-- Cover Image -->
    <div class="container">
      <div class="post-cover reveal">
        <img
          src={post.image}
          alt=""
          class="cover-img"
          width="1200"
          height="630"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- Content -->
    <div class="container post-layout">
      <div class="post-body">
        <p class="post-lead">{post.excerpt}</p>

        {thisIsPillar && guideSpokes.length > 0 && (
          <nav class="guide-contents" aria-labelledby="guide-contents-heading">
            <p id="guide-contents-heading" class="guide-contents-label">In this guide series</p>
            <ol class="guide-contents-list">
              {guideSpokes.map((g: any) => (
                <li>
                  <a href={`/blog/${g.slug}/`}>{g.title}</a>
                  <span class="guide-contents-meta">{g.readTime}</span>
                </li>
              ))}
            </ol>
          </nav>
        )}

        {pillarPost && (
          <aside class="pillar-link">
            Part of our guide:
            <a href={`/blog/${pillarPost.slug}/`}>{pillarPost.title}</a>
          </aside>
        )}

        <div class="post-content" set:html={post.body} />

        <!-- Related topics CTA -->
        <div class="post-topics">
          <p class="topics-label">Related Services</p>
          <div class="topics-list">
            {relatedServices.map((s: any) => (
              <a href={`/services/${s.slug}/`} class="topic-tag">{s.title}</a>
            ))}
            <a href="/services/" class="topic-tag">All Services</a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="post-sidebar">
        <div class="sidebar-card">
          <p class="sidebar-label">Talk to an Expert</p>
          <h3 class="sidebar-title">Get a personalised strategy for your business</h3>
          <p class="sidebar-desc">Book a free 30-minute call with one of our senior strategists. No pitch, no commitment — just real insights.</p>
          <a href="/contact/" class="btn-gold sidebar-cta">Book Free Call →</a>
          <a href="https://wa.me/971521456818" class="whatsapp-cta" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>

        <div class="sidebar-card sidebar-card--services">
          <p class="sidebar-label">Our Services</p>
          <ul class="sidebar-links">
            <li><a href="/services/paid-advertising/">Paid Advertising</a></li>
            <li><a href="/services/social-media-management/">Social Media</a></li>
            <li><a href="/services/branding-creative/">Branding &amp; Creative</a></li>
            <li><a href="/services/crm-pipeline-setup/">CRM &amp; Automation</a></li>
            <li><a href="/services/ai-receptionist-chatbots/">AI Marketing</a></li>
          </ul>
        </div>
      </aside>
    </div>
    <!-- Related articles -->
    <div class="container">
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading" class="related-heading">Keep reading</h2>
        <div class="related-grid">
          {related.map((r: any) => (
            <a href={`/blog/${r.slug}/`} class="related-card">
              <span class="related-cat">{r.category}</span>
              <span class="related-title">{r.title}</span>
              <span class="related-meta">
                <time datetime={r.datePublished}>{r.date}</time> · {r.readTime} read
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </article>
</Layout>

<style>
  /* Pillar / spoke relationship */
  .guide-contents {
    margin: 0 0 2.5rem;
    padding: 1.5rem 1.7rem;
    border: 1px solid var(--border-gold);
    border-radius: 14px;
    background: rgba(201, 168, 76, 0.05);
  }

  .guide-contents-label {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.9rem;
  }

  .guide-contents-list {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .guide-contents-list li { color: var(--text-dim); }

  .guide-contents-list a {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .guide-contents-list a:hover {
    color: var(--gold-light);
    border-bottom-color: var(--border-gold);
  }

  .guide-contents-meta {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-left: 0.5rem;
  }

  .pillar-link {
    margin: 0 0 2rem;
    padding: 0.85rem 1.1rem;
    border-left: 2px solid var(--gold-primary);
    background: rgba(201, 168, 76, 0.04);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .pillar-link a {
    color: var(--gold-light);
    margin-left: 0.4rem;
  }

  .post-updated {
    color: var(--gold-primary);
    font-size: 0.86rem;
  }

  /* Related articles */
  .related {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-subtle);
  }

  .related-heading {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.8rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    background: rgba(19, 34, 68, 0.45);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .related-card:hover {
    border-color: var(--border-gold);
    transform: translateY(-3px);
  }

  .related-cat {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-primary);
  }

  .related-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .related-meta {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .related-grid { grid-template-columns: 1fr; }
  }

  .post-page { padding-bottom: 6rem; }

  /* Hero */
  .post-hero {
    position: relative;
    padding-top: 72px;
    background: var(--bg-void);
    overflow: hidden;
  }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }
  .orb--purple {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(123,63,160,0.2) 0%, transparent 70%);
    top: -150px; left: -100px;
  }
  .orb--gold {
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(201,168,76,0.1) 0%, transparent 70%);
    top: -50px; right: -50px;
  }
  .post-hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 3rem;
    padding-bottom: 3rem;
    max-width: 860px;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--gold-primary); }
  .post-category {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-primary);
    background: rgba(201,168,76,0.08);
    border: 1px solid rgba(201,168,76,0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }
  .post-read-time {
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  .post-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .post-byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  .post-author { color: var(--gold-primary); font-weight: 500; }
  .byline-sep { color: var(--text-dim); }
  .post-date {
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  /* Cover */
  .post-cover {
    margin: 2rem 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }
  .cover-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  /* Layout */
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
    margin-top: 3rem;
  }

  /* Body */
  .post-lead {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Article prose */
  .post-content {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }
  .post-content :global(h2) {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .post-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .post-content :global(a) {
    color: var(--gold-primary);
    text-decoration: underline;
    transition: color 0.2s;
  }
  .post-content :global(a:hover) { color: var(--gold-light); }

  /* Topics */
  .post-topics { margin-top: 2rem; }
  .topics-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .topics-list { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .topic-tag {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .topic-tag:hover { border-color: var(--gold-primary); color: var(--gold-primary); }

  /* Sidebar */
  .post-sidebar { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 1.5rem; }
  .sidebar-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 1.75rem;
  }
  .sidebar-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-primary);
    margin-bottom: 0.75rem;
  }
  .sidebar-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .sidebar-desc {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .sidebar-cta { width: 100%; justify-content: center; margin-bottom: 0.75rem; }
  .whatsapp-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #4ade80;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .whatsapp-cta:hover { opacity: 0.8; }

  .sidebar-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sidebar-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sidebar-links a::before { content: '→'; color: var(--gold-primary); font-size: 0.8rem; }
  .sidebar-links a:hover { color: var(--text-primary); }

  /* Responsive */
  @media (max-width: 1024px) {
    .post-layout { grid-template-columns: 1fr; gap: 3rem; }
    .post-sidebar { position: static; }
  }
  @media (max-width: 640px) {
    .cover-img { height: 240px; }
    .post-meta { gap: 0.6rem; }
    .cs-actions { flex-direction: column; }
    .cs-actions a { width: 100%; justify-content: center; }
  }
</style>
