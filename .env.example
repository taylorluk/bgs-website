# Google Tag Manager container ID (GTM-XXXXXXX).
# When this is set, GTM is the ONLY container loaded and GA4 must be configured
# as a tag inside GTM — otherwise pageviews are counted twice.
PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Only used when PUBLIC_GTM_ID is empty. If you run GTM, put this ID into the
# GA4 Configuration tag inside GTM instead of setting it here.
PUBLIC_GA_ID=

# PostHog project token (phc_...) and ingestion host.
# Independent of GA/GTM above — PostHog can run alongside either.
# Gated by the same consent banner: opted out with in-memory persistence
# until the visitor allows analytics.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Set both in Netlify under Site configuration > Environment variables.
# The PUBLIC_ prefix is required for Astro to expose them to the browser.
# Analytics only ships in production builds.
